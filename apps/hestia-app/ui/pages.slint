import { ComboBox, LineEdit, Slider, Switch, Spinner, TextEdit } from "std-widgets.slint";
import { Theme, PillButton, LinkButton, Chip, IconButton, Fab, MenuItem } from "theme.slint";

export struct HostCard {
    id: string,
    name: string,
    address: string,
    online: bool,
    checking: bool,
    paired: bool,
    hermes: bool,
    version: string,
    status: string,
    // Hermes readiness preflight: 0 unknown, 1 ready, 2 warnings, 3 not ready.
    health: int,
}

export struct AppCard {
    id: int,
    title: string,
    art: image,
    has-art: bool,
    running: bool,
    hdr: bool,
}

component StatusDot inherits Rectangle {
    in property <color> tone;
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background: root.tone;
}

component HostTile inherits Rectangle {
    in property <HostCard> host;
    callback clicked;

    // TV remote / keyboard: the grid moves the focus (`want-focus`);
    // Return presses, arrows and Back go to `nav`.
    in property <bool> want-focus;
    callback nav(string) -> bool;
    init => {
        if (self.want-focus) {
            fs.focus();
        }
    }
    changed want-focus => {
        if (self.want-focus) {
            fs.focus();
        }
    }
    fs := FocusScope {
        width: 0;
        height: 0;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            if (root.nav(event.text)) {
                return accept;
            }
            return reject;
        }
    }

    border-radius: Theme.radius;
    background: touch.has-hover || fs.has-focus ? Theme.card-hover : Theme.card;
    border-width: fs.has-focus ? 3px : 1px;
    border-color: fs.has-focus ? Theme.accent : (root.host.paired ? Theme.accent.transparentize(0.6) : Theme.border);
    drop-shadow-blur: 18px;
    drop-shadow-color: #00000050;
    animate background { duration: 120ms; }

    VerticalLayout {
        padding: Theme.compact ? 16px : 18px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                StatusDot {
                    tone: root.host.checking ? Theme.warn : (root.host.online ? Theme.ok : Theme.muted);
                }
            }
            Text {
                text: root.host.name;
                color: Theme.text;
                font-size: 18px;
                font-weight: 700;
                overflow: elide;
                vertical-alignment: center;
            }
        }

        Text {
            text: root.host.address;
            color: Theme.muted;
            font-size: 13px;
            overflow: elide;
        }

        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            Chip {
                text: root.host.checking ? "Checking" : (root.host.online ? "Online" : "Offline");
                tone: root.host.checking ? Theme.warn : (root.host.online ? Theme.ok : Theme.muted);
            }
            Chip {
                text: root.host.paired ? "Paired" : "Not paired";
                tone: root.host.paired ? Theme.accent : Theme.warn;
            }
            if root.host.hermes: Chip {
                text: root.host.version == "" ? "Hermes" : "Hermes " + root.host.version;
                tone: Theme.info;
            }
            if root.host.health > 0: Chip {
                text: root.host.health == 1 ? "Ready" : root.host.health == 2 ? "Check" : "Not ready";
                tone: root.host.health == 1 ? Theme.ok : root.host.health == 2 ? Theme.warn : Theme.danger;
            }
        }

        Rectangle {
            vertical-stretch: 1;
        }

        Text {
            text: root.host.status;
            color: Theme.muted;
            font-size: 12px;
            wrap: word-wrap;
            overflow: elide;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component AppTile inherits Rectangle {
    in property <AppCard> app;
    callback clicked;

    // TV remote / keyboard: the grid moves the focus (`want-focus`);
    // Return presses, arrows and Back go to `nav`.
    in property <bool> want-focus;
    callback nav(string) -> bool;
    init => {
        if (self.want-focus) {
            fs.focus();
        }
    }
    changed want-focus => {
        if (self.want-focus) {
            fs.focus();
        }
    }
    fs := FocusScope {
        width: 0;
        height: 0;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            if (root.nav(event.text)) {
                return accept;
            }
            return reject;
        }
    }

    border-radius: Theme.radius;
    background: Theme.card;
    clip: true;
    border-width: fs.has-focus ? 3px : (root.app.running ? 2px : 1px);
    border-color: fs.has-focus ? Theme.text : (root.app.running ? Theme.accent : (touch.has-hover ? Theme.accent.transparentize(0.5) : Theme.border));
    animate border-color { duration: 120ms; }

    VerticalLayout {
        Rectangle {
            vertical-stretch: 1;
            background: Theme.surface;
            clip: true;

            if root.app.has-art: Image {
                width: parent.width;
                height: parent.height;
                source: root.app.art;
                image-fit: cover;
            }

            if !root.app.has-art: Text {
                width: parent.width - 24px;
                x: 12px;
                height: parent.height;
                text: root.app.title;
                color: Theme.muted;
                font-size: 17px;
                font-weight: 700;
                wrap: word-wrap;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            Rectangle {
                background: touch.has-hover ? #ffffff10 : transparent;
                animate background { duration: 120ms; }
            }
        }

        HorizontalLayout {
            height: 44px;
            padding-left: 12px;
            padding-right: 10px;
            spacing: 6px;
            Text {
                text: root.app.title;
                color: Theme.text;
                font-size: 14px;
                font-weight: 600;
                overflow: elide;
                vertical-alignment: center;
            }
            if root.app.running: VerticalLayout {
                alignment: center;
                Chip {
                    text: "Running";
                    tone: Theme.accent;
                }
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component PageHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> show-back: false;
    callback back;
    padding-left: Theme.compact && root.show-back ? 6px : Theme.page-padding;
    padding-right: Theme.compact ? 8px : Theme.page-padding;
    padding-top: Theme.compact ? 10px : Theme.page-padding;
    padding-bottom: 8px;
    spacing: Theme.compact ? 2px : 10px;

    if root.show-back: VerticalLayout {
        alignment: center;
        IconButton {
            icon: "back";
            clicked => {
                root.back();
            }
        }
    }

    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        padding-left: Theme.compact && root.show-back ? 4px : 0px;
        Text {
            text: root.title;
            color: Theme.text;
            font-size: Theme.compact ? 22px : 26px;
            font-weight: 800;
            overflow: elide;
        }
        if root.subtitle != "": Text {
            text: root.subtitle;
            color: Theme.muted;
            font-size: 13px;
            overflow: elide;
        }
    }

    @children
}

export component HostsPage inherits Rectangle {
    in property <[HostCard]> hosts;
    in property <bool> scanning;
    callback open-host(string);
    callback add-host;
    callback refresh;
    callback settings;

    // TV remote / arrow keys: the focused card (0…), or a header action
    // (-2 Refresh, -3 Settings, -4 Add host); -1 before the first key.
    property <int> nav: -1;
    // Bumped by the window when a dialog closes: take the focus back.
    in property <int> refocus;
    changed refocus => {
        start.focus();
        root.nav = -1;
    }
    function move(from: int, key: string) -> bool {
        if (from >= 0) {
            if (key == Key.RightArrow && from + 1 < root.hosts.length) {
                root.nav = from + 1;
            } else if (key == Key.LeftArrow && from > 0) {
                root.nav = from - 1;
            } else if (key == Key.DownArrow && from + root.cols < root.hosts.length) {
                root.nav = from + root.cols;
            } else if (key == Key.DownArrow && Math.floor(from / root.cols) < Math.floor((root.hosts.length - 1) / root.cols)) {
                root.nav = root.hosts.length - 1;
            } else if (key == Key.UpArrow && from >= root.cols) {
                root.nav = from - root.cols;
            } else if (key == Key.UpArrow) {
                root.nav = -2;
            } else {
                return false;
            }
            return true;
        }
        if (key == Key.RightArrow && from > -4) {
            root.nav = from - 1;
        } else if (key == Key.LeftArrow && from < -2) {
            root.nav = from + 1;
        } else if (key == Key.DownArrow && root.hosts.length > 0) {
            root.nav = 0;
        } else {
            return false;
        }
        return true;
    }
    start := FocusScope {
        width: 0;
        height: 0;
        init => {
            self.focus();
        }
        key-pressed(event) => {
            if (event.text == Key.UpArrow || event.text == Key.DownArrow || event.text == Key.LeftArrow || event.text == Key.RightArrow) {
                root.nav = root.hosts.length > 0 ? 0 : -4;
                return accept;
            }
            return reject;
        }
    }

    property <length> pad: Theme.page-padding;
    property <length> gap: Theme.compact ? 12px : 16px;
    property <length> min-tile: 260px;
    property <int> cols: Math.max(1, Math.floor((root.width - 2 * root.pad + root.gap) / (root.min-tile + root.gap)));
    property <length> tile-w: (root.width - 2 * root.pad - (root.cols - 1) * root.gap) / root.cols;
    property <length> tile-h: Theme.compact ? 150px : 168px;
    // Room under the last row for the floating button.
    property <length> bottom-space: Theme.compact ? 96px : root.pad;

    VerticalLayout {
        PageHeader {
            title: "Hestia";
            subtitle: root.scanning ? "Looking for hosts on your network…" : "Your hosts";
            if root.scanning: VerticalLayout {
                alignment: center;
                Spinner {
                    width: 22px;
                    height: 22px;
                    indeterminate: true;
                }
            }
            if Theme.compact: VerticalLayout {
                alignment: center;
                IconButton {
                    icon: "refresh";
                    want-focus: root.nav == -2;
                    nav(key) => {
                        return root.move(-2, key);
                    }
                    clicked => {
                        root.refresh();
                    }
                }
            }
            if Theme.compact: VerticalLayout {
                alignment: center;
                IconButton {
                    icon: "settings";
                    want-focus: root.nav == -3;
                    nav(key) => {
                        return root.move(-3, key);
                    }
                    clicked => {
                        root.settings();
                    }
                }
            }
            if !Theme.compact: VerticalLayout {
                alignment: center;
                PillButton {
                    text: "Refresh";
                    want-focus: root.nav == -2;
                    nav(key) => {
                        return root.move(-2, key);
                    }
                    clicked => {
                        root.refresh();
                    }
                }
            }
            if !Theme.compact: VerticalLayout {
                alignment: center;
                PillButton {
                    text: "Settings";
                    want-focus: root.nav == -3;
                    nav(key) => {
                        return root.move(-3, key);
                    }
                    clicked => {
                        root.settings();
                    }
                }
            }
            if !Theme.compact: VerticalLayout {
                alignment: center;
                PillButton {
                    text: "Add host";
                    primary: true;
                    want-focus: root.nav == -4;
                    nav(key) => {
                        return root.move(-4, key);
                    }
                    clicked => {
                        root.add-host();
                    }
                }
            }
        }

        if root.hosts.length == 0: VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            padding: 32px;
            spacing: 10px;
            Text {
                text: "No hosts yet";
                color: Theme.text;
                font-size: 20px;
                font-weight: 700;
                horizontal-alignment: center;
            }
            Text {
                text: "Hosts running Hermes (or Sunshine/Apollo) on this network show up here automatically. You can also add one by its IP address.";
                color: Theme.muted;
                font-size: Theme.body-size;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
        }

        if root.hosts.length > 0: Flickable {
            vertical-stretch: 1;
            content-width: self.width;
            content-height: Math.ceil(root.hosts.length / root.cols) * (root.tile-h + root.gap) + root.bottom-space;
            // Keep the focused card in view.
            property <int> focused-row: root.nav >= 0 ? Math.floor(root.nav / root.cols) : -1;
            property <length> row-top: 8px + self.focused-row * (root.tile-h + root.gap);
            changed focused-row => {
                if (self.focused-row >= 0 && self.row-top + self.viewport-y < 0) {
                    self.viewport-y = 8px - self.row-top;
                } else if (self.focused-row >= 0 && self.row-top + root.tile-h + self.viewport-y > self.height) {
                    self.viewport-y = self.height - self.row-top - root.tile-h - root.gap;
                }
            }

            for host[i] in root.hosts: HostTile {
                x: root.pad + Math.mod(i, root.cols) * (root.tile-w + root.gap);
                y: 8px + Math.floor(i / root.cols) * (root.tile-h + root.gap);
                width: root.tile-w;
                height: root.tile-h;
                host: host;
                want-focus: root.nav == i;
                nav(key) => {
                    return root.move(i, key);
                }
                clicked => {
                    root.open-host(host.id);
                }
            }
        }
    }

    if Theme.compact: Fab {
        x: root.width - self.width - 16px;
        y: root.height - self.height - 20px;
        icon: "add";
        text: "Add host";
        want-focus: root.nav == -4;
        nav(key) => {
            return root.move(-4, key);
        }
        clicked => {
            root.add-host();
        }
    }
}

export component AppsPage inherits Rectangle {
    in property <string> host-name;
    in property <string> host-detail;
    in property <[string]> chips;
    in property <[AppCard]> apps;
    in property <bool> loading;
    in property <bool> app-running;
    in property <bool> hermes;
    // "Settings" first, then the saved profiles; shown when there are any.
    in property <[string]> profile-options;
    in-out property <int> profile-index;
    callback profile-chosen(int);
    callback back;
    callback launch(int);
    callback quit-app;
    callback forget;
    callback tools;

    property <bool> menu-open: false;
    property <length> pad: Theme.page-padding;
    property <length> gap: Theme.compact ? 12px : 16px;
    property <length> min-tile: Theme.compact ? 140px : 150px;

    // TV remote / arrow keys: the focused app (0…), or a header action
    // (-2 Back / "more", -3 Tools, -4 Quit app, -5 Forget); -1 before the
    // first key.
    property <int> nav: -1;
    in property <int> refocus;
    changed refocus => {
        start.focus();
        root.nav = -1;
    }
    function header-ok(code: int) -> bool {
        return Theme.compact
            ? code == -2
            : (code == -2 || code == -5 || (code == -3 && root.hermes) || (code == -4 && root.app-running));
    }
    function header-step(from: int, dir: int) -> int {
        if (root.header-ok(from + dir)) {
            return from + dir;
        }
        if (root.header-ok(from + 2 * dir)) {
            return from + 2 * dir;
        }
        if (root.header-ok(from + 3 * dir)) {
            return from + 3 * dir;
        }
        return from;
    }
    function move(from: int, key: string) -> bool {
        if (from >= 0) {
            if (key == Key.RightArrow && from + 1 < root.apps.length) {
                root.nav = from + 1;
            } else if (key == Key.LeftArrow && from > 0) {
                root.nav = from - 1;
            } else if (key == Key.DownArrow && from + root.cols < root.apps.length) {
                root.nav = from + root.cols;
            } else if (key == Key.DownArrow && Math.floor(from / root.cols) < Math.floor((root.apps.length - 1) / root.cols)) {
                root.nav = root.apps.length - 1;
            } else if (key == Key.UpArrow && from >= root.cols) {
                root.nav = from - root.cols;
            } else if (key == Key.UpArrow) {
                root.nav = -2;
            } else {
                return false;
            }
            return true;
        }
        if (key == Key.RightArrow && root.header-step(from, -1) != from) {
            root.nav = root.header-step(from, -1);
        } else if (key == Key.LeftArrow && root.header-step(from, 1) != from) {
            root.nav = root.header-step(from, 1);
        } else if (key == Key.DownArrow && root.apps.length > 0) {
            root.nav = 0;
        } else {
            return false;
        }
        return true;
    }
    start := FocusScope {
        width: 0;
        height: 0;
        init => {
            self.focus();
        }
        key-pressed(event) => {
            if (event.text == Key.UpArrow || event.text == Key.DownArrow || event.text == Key.LeftArrow || event.text == Key.RightArrow) {
                root.nav = root.apps.length > 0 ? 0 : -2;
                return accept;
            }
            return reject;
        }
    }
    property <int> cols: Math.max(2, Math.floor((root.width - 2 * root.pad + root.gap) / (root.min-tile + root.gap)));
    property <length> tile-w: (root.width - 2 * root.pad - (root.cols - 1) * root.gap) / root.cols;
    property <length> tile-h: root.tile-w * 4 / 3 + 44px;

    VerticalLayout {
        PageHeader {
            title: root.host-name;
            subtitle: root.host-detail;
            show-back: Theme.compact;
            back => {
                root.back();
            }
            if Theme.compact: VerticalLayout {
                alignment: center;
                IconButton {
                    icon: "more";
                    want-focus: root.nav == -2;
                    nav(key) => {
                        return root.move(-2, key);
                    }
                    clicked => {
                        root.menu-open = !root.menu-open;
                    }
                }
            }
            if !Theme.compact: VerticalLayout {
                alignment: center;
                PillButton {
                    text: "Back";
                    want-focus: root.nav == -2;
                    nav(key) => {
                        return root.move(-2, key);
                    }
                    clicked => {
                        root.back();
                    }
                }
            }
            if !Theme.compact && root.hermes: VerticalLayout {
                alignment: center;
                PillButton {
                    text: "Tools";
                    want-focus: root.nav == -3;
                    nav(key) => {
                        return root.move(-3, key);
                    }
                    clicked => {
                        root.tools();
                    }
                }
            }
            if !Theme.compact && root.app-running: VerticalLayout {
                alignment: center;
                PillButton {
                    text: "Quit app";
                    danger: true;
                    want-focus: root.nav == -4;
                    nav(key) => {
                        return root.move(-4, key);
                    }
                    clicked => {
                        root.quit-app();
                    }
                }
            }
            if !Theme.compact: VerticalLayout {
                alignment: center;
                PillButton {
                    text: "Forget";
                    want-focus: root.nav == -5;
                    nav(key) => {
                        return root.move(-5, key);
                    }
                    clicked => {
                        root.forget();
                    }
                }
            }
        }

        // Host facts; scrolls sideways on narrow screens instead of clipping.
        if root.chips.length > 0: Flickable {
            height: 32px;
            content-height: 32px;
            content-width: chip-row.preferred-width + 2 * root.pad;
            chip-row := HorizontalLayout {
                x: root.pad;
                y: 2px;
                width: self.preferred-width;
                height: 24px;
                spacing: 6px;
                for chip in root.chips: Chip {
                    text: chip;
                    tone: Theme.info;
                }
            }
        }

        // Which stream profile this host launches with.
        if root.profile-options.length > 1: HorizontalLayout {
            padding-left: root.pad;
            padding-right: root.pad;
            padding-bottom: 8px;
            spacing: 10px;
            Text {
                text: "Stream profile";
                color: Theme.muted;
                font-size: 13px;
                vertical-alignment: center;
            }
            ComboBox {
                width: Math.min(240px, root.width - 2 * root.pad - 120px);
                model: root.profile-options;
                current-index <=> root.profile-index;
                selected(value) => {
                    root.profile-chosen(self.current-index);
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
        }

        // Phones: what's running and a big Quit, instead of a header button.
        if Theme.compact && root.app-running: HorizontalLayout {
            padding-left: root.pad;
            padding-right: root.pad;
            padding-bottom: 8px;
            Rectangle {
                height: 56px;
                border-radius: 14px;
                background: Theme.accent.transparentize(0.86);
                border-width: 1px;
                border-color: Theme.accent.transparentize(0.6);
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 6px;
                    spacing: 8px;
                    Text {
                        text: "An app is running on this host";
                        color: Theme.text;
                        font-size: 14px;
                        font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    VerticalLayout {
                        alignment: center;
                        PillButton {
                            text: "Quit";
                            danger: true;
                            clicked => {
                                root.quit-app();
                            }
                        }
                    }
                }
            }
        }

        if root.loading: VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            HorizontalLayout {
                alignment: center;
                Spinner {
                    width: 36px;
                    height: 36px;
                    indeterminate: true;
                }
            }
        }

        if !root.loading && root.apps.length == 0: VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            padding: 24px;
            Text {
                text: "This host has no apps you are allowed to see.";
                color: Theme.muted;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
        }

        if !root.loading && root.apps.length > 0: Flickable {
            vertical-stretch: 1;
            content-width: self.width;
            content-height: Math.ceil(root.apps.length / root.cols) * (root.tile-h + root.gap) + root.pad;
            // Keep the focused app in view.
            property <int> focused-row: root.nav >= 0 ? Math.floor(root.nav / root.cols) : -1;
            property <length> row-top: 8px + self.focused-row * (root.tile-h + root.gap);
            changed focused-row => {
                if (self.focused-row >= 0 && self.row-top + self.viewport-y < 0) {
                    self.viewport-y = 8px - self.row-top;
                } else if (self.focused-row >= 0 && self.row-top + root.tile-h + self.viewport-y > self.height) {
                    self.viewport-y = self.height - self.row-top - root.tile-h - root.gap;
                }
            }

            for app[i] in root.apps: AppTile {
                x: root.pad + Math.mod(i, root.cols) * (root.tile-w + root.gap);
                y: 8px + Math.floor(i / root.cols) * (root.tile-h + root.gap);
                width: root.tile-w;
                height: root.tile-h;
                app: app;
                want-focus: root.nav == i;
                nav(key) => {
                    return root.move(i, key);
                }
                clicked => {
                    root.launch(app.id);
                }
            }
        }
    }

    // Overflow menu (phones).
    if root.menu-open: TouchArea {
        clicked => {
            root.menu-open = false;
        }
    }
    if root.menu-open: Rectangle {
        x: root.width - self.width - 8px;
        y: 60px;
        width: 240px;
        height: menu.preferred-height;
        border-radius: 14px;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000090;
        menu := VerticalLayout {
            padding: 6px;
            if root.app-running: MenuItem {
                icon: "stop";
                text: "Quit running app";
                danger: true;
                clicked => {
                    root.menu-open = false;
                    root.quit-app();
                }
            }
            if root.hermes: MenuItem {
                icon: "tools";
                text: "Host tools";
                clicked => {
                    root.menu-open = false;
                    root.tools();
                }
            }
            MenuItem {
                icon: "delete";
                text: "Forget this host";
                clicked => {
                    root.menu-open = false;
                    root.forget();
                }
            }
        }
    }
}

export component SessionPage inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <[string]> lines;
    in property <bool> busy;
    callback back;
    callback quit-app;

    VerticalLayout {
        PageHeader {
            title: root.title;
            subtitle: root.subtitle;
        }

        VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            padding: Theme.page-padding;

            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: Math.min(560px, root.width - 2 * Theme.page-padding);
                    border-radius: Theme.radius;
                    background: Theme.card;
                    border-width: 1px;
                    border-color: Theme.border;

                    VerticalLayout {
                        padding: 24px;
                        spacing: 10px;

                        if root.busy: HorizontalLayout {
                            alignment: center;
                            Spinner {
                                width: 32px;
                                height: 32px;
                                indeterminate: true;
                            }
                        }

                        for line in root.lines: Text {
                            text: line;
                            color: Theme.text;
                            font-size: 14px;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            alignment: end;
                            PillButton {
                                text: root.busy ? "Cancel" : "Back to apps";
                                clicked => {
                                    root.back();
                                }
                            }
                            PillButton {
                                text: "Quit app";
                                danger: true;
                                enabled: !root.busy;
                                clicked => {
                                    root.quit-app();
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

component SettingRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> hint;
    spacing: Theme.compact ? 12px : 16px;
    min-height: Theme.compact ? 60px : 48px;
    padding-top: Theme.compact ? 4px : 0px;
    padding-bottom: Theme.compact ? 4px : 0px;

    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        spacing: 2px;
        Text {
            text: root.label;
            color: Theme.text;
            font-size: Theme.body-size;
            font-weight: 600;
            wrap: word-wrap;
        }
        if root.hint != "": Text {
            text: root.hint;
            color: Theme.muted;
            font-size: 12px;
            wrap: word-wrap;
        }
    }

    VerticalLayout {
        alignment: center;
        horizontal-stretch: 0;
        @children
    }
}

component SectionTitle inherits VerticalLayout {
    in property <string> text;
    padding-top: 18px;
    padding-bottom: 4px;
    Text {
        text: root.text;
        color: Theme.accent;
        font-size: 13px;
        font-weight: 700;
    }
}

export component SettingsPage inherits Rectangle {
    in property <[string]> resolution-options;
    in property <[string]> fps-options;
    in-out property <int> preset;
    in property <string> preset-hint;
    in-out property <int> video-scale;
    callback preset-changed(int);
    in-out property <int> resolution;
    in-out property <int> fps;
    in-out property <float> bitrate-mbps;
    in-out property <int> codec;
    in-out property <int> audio;
    in-out property <bool> hdr;
    in-out property <bool> virtual-display;
    in-out property <bool> host-audio;
    in-out property <bool> gamescope;
    in-out property <bool> optimize;
    in-out property <bool> clipboard;
    in property <string> client-id;
    in property <string> data-dir;
    in property <string> version;
    in-out property <bool> show-report;
    in-out property <bool> show-menu-button;
    in-out property <bool> hardware-decoding;
    in-out property <bool> gpu-video;
    // Settings that only exist on Android.
    in property <bool> android;
    // 0 landscape, 1 portrait, 2 follow the device
    in-out property <int> orientation;
    callback custom-resolution(string);
    in property <[string]> profile-names;
    in-out property <int> profile-pick;
    callback save-profile(string);
    callback load-profile(int);
    callback delete-profile(int);
    callback back;
    callback save;
    callback open-last-report;
    callback open-app-log;

    // Pickers get at most ~45% of the row so labels keep their room.
    property <length> picker-w: Math.min(Theme.compact ? 160px : 170px, (root.width - 2 * Theme.page-padding) * 0.45);
    property <length> slider-w: Math.min(200px, (root.width - 2 * Theme.page-padding) * 0.45);

    VerticalLayout {
        PageHeader {
            title: "Settings";
            subtitle: "Applied to the next session";
            show-back: Theme.compact;
            back => {
                root.back();
            }
            if !Theme.compact: VerticalLayout {
                alignment: center;
                PillButton {
                    text: "Back";
                    clicked => {
                        root.back();
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                PillButton {
                    text: "Save";
                    primary: true;
                    clicked => {
                        root.save();
                    }
                }
            }
        }

        Flickable {
            vertical-stretch: 1;
            content-width: self.width;
            content-height: form.preferred-height;
            form := HorizontalLayout {
                width: root.width;
                alignment: center;
                VerticalLayout {
                    width: Math.min(640px, root.width - 2 * Theme.page-padding);
                    padding-top: 8px;
                    padding-bottom: 32px;
                    spacing: Theme.compact ? 2px : 6px;

                    SectionTitle {
                        text: "Profiles";
                    }
                    SettingRow {
                        label: "Save as profile";
                        hint: "Keeps this page's video, audio and host settings under a name; choose it per host on the host's page";
                        HorizontalLayout {
                            spacing: 6px;
                            width: root.picker-w;
                            profile-name := LineEdit {
                                placeholder-text: "Couch TV";
                                accepted(text) => {
                                    root.save-profile(text);
                                    self.text = "";
                                }
                            }
                            PillButton {
                                text: "Save";
                                clicked => {
                                    root.save-profile(profile-name.text);
                                    profile-name.text = "";
                                }
                            }
                        }
                    }
                    if root.profile-names.length > 0: SettingRow {
                        label: "Saved profiles";
                        hint: "Load one into this page (then Save), or delete it";
                        VerticalLayout {
                            spacing: 6px;
                            width: root.picker-w;
                            ComboBox {
                                model: root.profile-names;
                                current-index <=> root.profile-pick;
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                PillButton {
                                    text: "Load";
                                    clicked => {
                                        root.load-profile(root.profile-pick);
                                    }
                                }
                                PillButton {
                                    text: "Delete";
                                    danger: true;
                                    clicked => {
                                        root.delete-profile(root.profile-pick);
                                    }
                                }
                            }
                        }
                    }

                    SectionTitle {
                        text: "Video";
                    }
                    SettingRow {
                        label: "Preset";
                        hint: root.preset-hint;
                        ComboBox {
                            width: root.picker-w;
                            model: ["Custom", "Fast", "Balanced", "Quality", "Battery saver"];
                            current-index <=> root.preset;
                            selected(value) => {
                                root.preset-changed(self.current-index);
                            }
                        }
                    }
                    SettingRow {
                        label: "Resolution";
                        ComboBox {
                            width: root.picker-w;
                            model: root.resolution-options;
                            current-index <=> root.resolution;
                            // Editing the mode by hand leaves the preset.
                            selected(value) => {
                                root.preset = 0;
                            }
                        }
                    }
                    SettingRow {
                        label: "Custom resolution";
                        hint: "Width × height, e.g. 2560x1080";
                        HorizontalLayout {
                            spacing: 6px;
                            width: root.picker-w;
                            custom-res := LineEdit {
                                placeholder-text: "2560x1080";
                                accepted(text) => {
                                    root.custom-resolution(text);
                                    self.text = "";
                                }
                            }
                            PillButton {
                                text: "Use";
                                clicked => {
                                    root.custom-resolution(custom-res.text);
                                    custom-res.text = "";
                                }
                            }
                        }
                    }
                    SettingRow {
                        label: "Frame rate";
                        ComboBox {
                            width: root.picker-w;
                            model: root.fps-options;
                            current-index <=> root.fps;
                            selected(value) => {
                                root.preset = 0;
                            }
                        }
                    }
                    SettingRow {
                        label: "Bitrate";
                        hint: (Math.round(root.bitrate-mbps * 4) / 4) + " Mbps";
                        Slider {
                            width: root.slider-w;
                            minimum: 1;
                            maximum: 200;
                            value <=> root.bitrate-mbps;
                            changed(value) => {
                                root.preset = 0;
                            }
                        }
                    }
                    SettingRow {
                        label: "Picture";
                        hint: root.video-scale == 0 ? "Whole picture, black bars if the shapes differ"
                            : root.video-scale == 1 ? "Fills the screen, crops the edges"
                            : "Fills the screen, distorts the picture";
                        ComboBox {
                            width: root.picker-w;
                            model: ["Fit", "Fill", "Stretch"];
                            current-index <=> root.video-scale;
                        }
                    }
                    SettingRow {
                        label: "Codec";
                        hint: "Auto picks the best one both sides support";
                        ComboBox {
                            width: root.picker-w;
                            model: ["Auto", "H.264", "HEVC", "AV1"];
                            current-index <=> root.codec;
                        }
                    }
                    SettingRow {
                        label: "Hardware decoding";
                        hint: "Faster and lighter on the battery; turn off to compare with the software decoder (H.264 only)";
                        Switch {
                            checked <=> root.hardware-decoding;
                        }
                    }
                    if root.android && root.hardware-decoding: SettingRow {
                        label: "Zero-copy video";
                        hint: "The decoder's pictures go straight to the GPU, like Moonlight; turn off to read them on the CPU";
                        Switch {
                            checked <=> root.gpu-video;
                        }
                    }
                    SettingRow {
                        label: "HDR";
                        hint: "Needs HDR support on the host (Hermes-KMS) and this display";
                        Switch {
                            checked <=> root.hdr;
                        }
                    }

                    SectionTitle {
                        text: "Hermes";
                    }
                    SettingRow {
                        label: "Virtual display";
                        hint: "Stream from a virtual display sized to this device";
                        Switch {
                            checked <=> root.virtual-display;
                        }
                    }
                    SettingRow {
                        label: "Gamescope session";
                        hint: "Run games in an isolated Gamescope session when the host supports it";
                        Switch {
                            checked <=> root.gamescope;
                        }
                    }
                    SettingRow {
                        label: "Clipboard sync";
                        hint: "Hermes hosts: what you copy on either side can be pasted on the other while streaming";
                        Switch {
                            checked <=> root.clipboard;
                        }
                    }

                    SectionTitle {
                        text: "Audio & host";
                    }
                    SettingRow {
                        label: "Speakers";
                        ComboBox {
                            width: root.picker-w;
                            model: ["Stereo", "5.1 surround", "7.1 surround"];
                            current-index <=> root.audio;
                        }
                    }
                    SettingRow {
                        label: "Play audio on host";
                        Switch {
                            checked <=> root.host-audio;
                        }
                    }
                    SettingRow {
                        label: "Optimize game settings";
                        hint: "Let the host adjust its display mode for the stream";
                        Switch {
                            checked <=> root.optimize;
                        }
                    }

                    SectionTitle {
                        text: "Stream screen";
                    }
                    SettingRow {
                        label: "Orientation";
                        hint: "While streaming on a phone or tablet";
                        ComboBox {
                            width: root.picker-w;
                            model: ["Landscape", "Portrait", "Follow the device"];
                            current-index <=> root.orientation;
                        }
                    }
                    SettingRow {
                        label: "Menu button";
                        hint: "Always show it. Otherwise Back (Escape on a keyboard) opens the menu; a 3-finger tap opens the keyboard";
                        Switch {
                            checked <=> root.show-menu-button;
                        }
                    }

                    SectionTitle {
                        text: "Diagnostics";
                    }
                    SettingRow {
                        label: "Report after each stream";
                        hint: "Statistics and every log line, ready to share";
                        Switch {
                            checked <=> root.show-report;
                        }
                    }
                    HorizontalLayout {
                        alignment: start;
                        padding-bottom: 4px;
                        spacing: 8px;
                        PillButton {
                            text: "Last stream report";
                            clicked => {
                                root.open-last-report();
                            }
                        }
                        PillButton {
                            text: "App log";
                            clicked => {
                                root.open-app-log();
                            }
                        }
                    }

                    SectionTitle {
                        text: "About";
                    }
                    Text {
                        text: root.version;
                        color: Theme.text;
                        font-size: 13px;
                    }
                    Text {
                        text: "Client id: " + root.client-id;
                        color: Theme.muted;
                        font-size: 12px;
                    }
                    Text {
                        text: "Data: " + root.data-dir;
                        color: Theme.muted;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}

export struct PreflightRow {
    // 1 ok, 2 warning, 3 failure
    level: int,
    title: string,
    message: string,
}

export struct CommandRow {
    id: int,
    name: string,
    // Hermes wants a confirmation before running it.
    confirm: bool,
    // First tap done; the next one runs it.
    armed: bool,
}

component ToolCard inherits Rectangle {
    in property <string> title;
    border-radius: Theme.radius;
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.border;
    height: card-body.preferred-height;
    card-body := VerticalLayout {
        width: 100%;
        padding: Theme.compact ? 14px : 16px;
        spacing: 10px;
        Text {
            text: root.title;
            color: Theme.text;
            font-size: 16px;
            font-weight: 700;
        }
        @children
    }
}

// Hermes host tools: display recovery, server commands, clipboard,
// this client's permissions and a diagnostics summary.
export component ToolsPage inherits Rectangle {
    in property <string> host-name;
    in property <bool> loading;
    // Error or note for the whole page ("not allowed", "not a Hermes host").
    in property <string> message;
    in property <string> display-status;
    in property <bool> display-allowed: true;
    in property <[CommandRow]> commands;
    in property <bool> commands-allowed: true;
    in property <bool> clipboard-allowed: true;
    in-out property <string> clipboard-text;
    in property <string> permissions;
    in property <[string]> diagnostics;
    in property <[string]> status-lines;
    in property <[PreflightRow]> preflight;
    in property <bool> busy;
    callback back;
    callback refresh;
    callback open-web-ui;
    callback host-report;
    callback recover-display;
    callback run-command(int);
    callback send-clipboard(string);
    callback fetch-clipboard;

    VerticalLayout {
        tools-header := PageHeader {
            title: "Host tools";
            subtitle: root.host-name;
            show-back: Theme.compact;
            back => {
                root.back();
            }
            if root.busy || root.loading: VerticalLayout {
                alignment: center;
                Spinner {
                    width: 22px;
                    height: 22px;
                    indeterminate: true;
                }
            }
            if Theme.compact: VerticalLayout {
                alignment: center;
                IconButton {
                    icon: "refresh";
                    clicked => {
                        root.refresh();
                    }
                }
            }
            if !Theme.compact: VerticalLayout {
                alignment: center;
                PillButton {
                    text: "Refresh";
                    clicked => {
                        root.refresh();
                    }
                }
            }
            if !Theme.compact: VerticalLayout {
                alignment: center;
                PillButton {
                    text: "Back";
                    clicked => {
                        root.back();
                    }
                }
            }
        }

        Flickable {
            height: root.height - tools-header.preferred-height;
            content-width: self.width;
            content-height: tools-form.preferred-height;
            tools-form := HorizontalLayout {
                width: root.width;
                alignment: center;
                VerticalLayout {
                    width: Math.min(640px, root.width - 2 * Theme.page-padding);
                    padding-top: 8px;
                    padding-bottom: 32px;
                    spacing: 12px;

                    if root.message != "": Text {
                        text: root.message;
                        color: Theme.warn;
                        wrap: word-wrap;
                    }

                    ToolCard {
                        title: "Host status";
                        if root.loading: Text {
                            text: "Checking…";
                            color: Theme.muted;
                            font-size: 13px;
                        }
                        for row in root.preflight: HorizontalLayout {
                            spacing: 10px;
                            VerticalLayout {
                                alignment: start;
                                padding-top: 4px;
                                Rectangle {
                                    width: 10px;
                                    height: 10px;
                                    border-radius: 5px;
                                    background: row.level == 1 ? Theme.ok : row.level == 2 ? Theme.warn : Theme.danger;
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text {
                                    text: row.title;
                                    color: Theme.text;
                                    font-size: 14px;
                                    font-weight: 600;
                                    wrap: word-wrap;
                                }
                                if row.message != "": Text {
                                    text: row.message;
                                    color: Theme.muted;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                        for line in root.status-lines: Text {
                            text: line;
                            color: Theme.muted;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            PillButton {
                                text: "Open web UI";
                                clicked => {
                                    root.open-web-ui();
                                }
                            }
                            PillButton {
                                text: "Diagnostic report";
                                enabled: !root.busy;
                                clicked => {
                                    root.host-report();
                                }
                            }
                        }
                    }

                    ToolCard {
                        title: "Display";
                        Text {
                            text: root.loading ? "Checking…" : root.display-status;
                            color: Theme.muted;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            alignment: start;
                            PillButton {
                                text: "Recover display";
                                enabled: root.display-allowed && !root.busy;
                                clicked => {
                                    root.recover-display();
                                }
                            }
                        }
                    }

                    ToolCard {
                        title: "Server commands";
                        if !root.loading && root.commands.length == 0: Text {
                            text: root.commands-allowed ? "No commands are configured on the host." : "This device may not run server commands.";
                            color: Theme.muted;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                        for cmd in root.commands: HorizontalLayout {
                            spacing: 10px;
                            min-height: Theme.control-height;
                            Text {
                                text: cmd.name;
                                color: Theme.text;
                                font-size: Theme.body-size;
                                vertical-alignment: center;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                            }
                            VerticalLayout {
                                alignment: center;
                                PillButton {
                                    text: cmd.armed ? "Confirm" : "Run";
                                    primary: cmd.armed;
                                    danger: cmd.confirm && !cmd.armed;
                                    enabled: root.commands-allowed && !root.busy;
                                    clicked => {
                                        root.run-command(cmd.id);
                                    }
                                }
                            }
                        }
                    }

                    ToolCard {
                        title: "Clipboard";
                        Text {
                            text: root.clipboard-allowed ? "Send text to the host's clipboard, or fetch what it holds." : "Clipboard sync is not allowed for this device.";
                            color: Theme.muted;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                        TextEdit {
                            height: 96px;
                            text <=> root.clipboard-text;
                            enabled: root.clipboard-allowed;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            PillButton {
                                text: "Send to host";
                                primary: true;
                                enabled: root.clipboard-allowed && !root.busy && root.clipboard-text != "";
                                clicked => {
                                    root.send-clipboard(root.clipboard-text);
                                }
                            }
                            PillButton {
                                text: "Get from host";
                                enabled: root.clipboard-allowed && !root.busy;
                                clicked => {
                                    root.fetch-clipboard();
                                }
                            }
                        }
                    }

                    ToolCard {
                        title: "This device";
                        Text {
                            text: root.permissions == "" ? "…" : root.permissions;
                            color: Theme.muted;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }

                    if root.diagnostics.length > 0: ToolCard {
                        title: "All diagnostics fields";
                        for line in root.diagnostics: Text {
                            text: line;
                            color: Theme.muted;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}

// Shown when a stream ends (or fails to start): what happened, where the
// full report with every log line was saved, and ways to get it out.
export component ReportPage inherits Rectangle {
    in property <string> title;
    in property <[string]> summary;
    in property <string> path;
    in property <[string]> log-tail;
    in property <string> export-label: "Share";
    in property <bool> can-send-to-host;
    in property <bool> busy;
    callback done;
    callback export;
    callback send-to-host;

    VerticalLayout {
        report-header := PageHeader {
            title: "Stream report";
            subtitle: root.title;
            show-back: Theme.compact;
            back => {
                root.done();
            }
            if root.busy: VerticalLayout {
                alignment: center;
                Spinner {
                    width: 22px;
                    height: 22px;
                    indeterminate: true;
                }
            }
            if !Theme.compact: VerticalLayout {
                alignment: center;
                PillButton {
                    text: "Done";
                    clicked => {
                        root.done();
                    }
                }
            }
        }

        // Explicit height: a short report must not leave the extra space to
        // the header (it would drift down the screen).
        Flickable {
            height: root.height - report-header.preferred-height;
            content-width: self.width;
            content-height: report-form.preferred-height;
            report-form := HorizontalLayout {
                width: root.width;
                alignment: center;
                VerticalLayout {
                    width: Math.min(720px, root.width - 2 * Theme.page-padding);
                    padding-top: 8px;
                    padding-bottom: 32px;
                    spacing: 12px;

                    ToolCard {
                        title: "Summary";
                        for line in root.summary: Text {
                            text: line;
                            color: Theme.text;
                            font-size: Theme.body-size;
                            wrap: word-wrap;
                        }
                    }

                    ToolCard {
                        title: "Full report";
                        Text {
                            text: root.path == "" ? "Not saved to a file." : "Saved with every log line to:\n" + root.path;
                            color: Theme.muted;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            PillButton {
                                text: root.export-label;
                                primary: true;
                                enabled: !root.busy;
                                clicked => {
                                    root.export();
                                }
                            }
                            if root.can-send-to-host: PillButton {
                                text: "Send to host clipboard";
                                enabled: !root.busy;
                                clicked => {
                                    root.send-to-host();
                                }
                            }
                        }
                    }

                    if root.log-tail.length > 0: ToolCard {
                        title: "Last log lines";
                        for line in root.log-tail: Text {
                            text: line;
                            color: Theme.muted;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}
