import { ComboBox, Slider, Switch, Spinner, TextEdit } from "std-widgets.slint";
import { Theme, PillButton, LinkButton, Chip, IconButton, Fab, MenuItem } from "theme.slint";

export struct HostCard {
    id: string,
    name: string,
    address: string,
    online: bool,
    checking: bool,
    paired: bool,
    hermes: bool,
    version: string,
    status: string,
}

export struct AppCard {
    id: int,
    title: string,
    art: image,
    has-art: bool,
    running: bool,
    hdr: bool,
}

component StatusDot inherits Rectangle {
    in property <color> tone;
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background: root.tone;
}

component HostTile inherits Rectangle {
    in property <HostCard> host;
    callback clicked;

    border-radius: Theme.radius;
    background: touch.has-hover ? Theme.card-hover : Theme.card;
    border-width: 1px;
    border-color: root.host.paired ? Theme.accent.transparentize(0.6) : Theme.border;
    drop-shadow-blur: 18px;
    drop-shadow-color: #00000050;
    animate background { duration: 120ms; }

    VerticalLayout {
        padding: Theme.compact ? 16px : 18px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                StatusDot {
                    tone: root.host.checking ? Theme.warn : (root.host.online ? Theme.ok : Theme.muted);
                }
            }
            Text {
                text: root.host.name;
                color: Theme.text;
                font-size: 18px;
                font-weight: 700;
                overflow: elide;
                vertical-alignment: center;
            }
        }

        Text {
            text: root.host.address;
            color: Theme.muted;
            font-size: 13px;
            overflow: elide;
        }

        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            Chip {
                text: root.host.checking ? "Checking" : (root.host.online ? "Online" : "Offline");
                tone: root.host.checking ? Theme.warn : (root.host.online ? Theme.ok : Theme.muted);
            }
            Chip {
                text: root.host.paired ? "Paired" : "Not paired";
                tone: root.host.paired ? Theme.accent : Theme.warn;
            }
            if root.host.hermes: Chip {
                text: root.host.version == "" ? "Hermes" : "Hermes " + root.host.version;
                tone: Theme.info;
            }
        }

        Rectangle {
            vertical-stretch: 1;
        }

        Text {
            text: root.host.status;
            color: Theme.muted;
            font-size: 12px;
            wrap: word-wrap;
            overflow: elide;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component AppTile inherits Rectangle {
    in property <AppCard> app;
    callback clicked;

    border-radius: Theme.radius;
    background: Theme.card;
    clip: true;
    border-width: root.app.running ? 2px : 1px;
    border-color: root.app.running ? Theme.accent : (touch.has-hover ? Theme.accent.transparentize(0.5) : Theme.border);
    animate border-color { duration: 120ms; }

    VerticalLayout {
        Rectangle {
            vertical-stretch: 1;
            background: Theme.surface;
            clip: true;

            if root.app.has-art: Image {
                width: parent.width;
                height: parent.height;
                source: root.app.art;
                image-fit: cover;
            }

            if !root.app.has-art: Text {
                width: parent.width - 24px;
                x: 12px;
                height: parent.height;
                text: root.app.title;
                color: Theme.muted;
                font-size: 17px;
                font-weight: 700;
                wrap: word-wrap;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            Rectangle {
                background: touch.has-hover ? #ffffff10 : transparent;
                animate background { duration: 120ms; }
            }
        }

        HorizontalLayout {
            height: 44px;
            padding-left: 12px;
            padding-right: 10px;
            spacing: 6px;
            Text {
                text: root.app.title;
                color: Theme.text;
                font-size: 14px;
                font-weight: 600;
                overflow: elide;
                vertical-alignment: center;
            }
            if root.app.running: VerticalLayout {
                alignment: center;
                Chip {
                    text: "Running";
                    tone: Theme.accent;
                }
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component PageHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> show-back: false;
    callback back;
    padding-left: Theme.compact && root.show-back ? 6px : Theme.page-padding;
    padding-right: Theme.compact ? 8px : Theme.page-padding;
    padding-top: Theme.compact ? 10px : Theme.page-padding;
    padding-bottom: 8px;
    spacing: Theme.compact ? 2px : 10px;

    if root.show-back: VerticalLayout {
        alignment: center;
        IconButton {
            icon: "back";
            clicked => {
                root.back();
            }
        }
    }

    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        padding-left: Theme.compact && root.show-back ? 4px : 0px;
        Text {
            text: root.title;
            color: Theme.text;
            font-size: Theme.compact ? 22px : 26px;
            font-weight: 800;
            overflow: elide;
        }
        if root.subtitle != "": Text {
            text: root.subtitle;
            color: Theme.muted;
            font-size: 13px;
            overflow: elide;
        }
    }

    @children
}

export component HostsPage inherits Rectangle {
    in property <[HostCard]> hosts;
    in property <bool> scanning;
    callback open-host(string);
    callback add-host;
    callback refresh;
    callback settings;

    property <length> pad: Theme.page-padding;
    property <length> gap: Theme.compact ? 12px : 16px;
    property <length> min-tile: 260px;
    property <int> cols: Math.max(1, Math.floor((root.width - 2 * root.pad + root.gap) / (root.min-tile + root.gap)));
    property <length> tile-w: (root.width - 2 * root.pad - (root.cols - 1) * root.gap) / root.cols;
    property <length> tile-h: Theme.compact ? 150px : 168px;
    // Room under the last row for the floating button.
    property <length> bottom-space: Theme.compact ? 96px : root.pad;

    VerticalLayout {
        PageHeader {
            title: "Hestia";
            subtitle: root.scanning ? "Looking for hosts on your network…" : "Your hosts";
            if root.scanning: VerticalLayout {
                alignment: center;
                Spinner {
                    width: 22px;
                    height: 22px;
                    indeterminate: true;
                }
            }
            if Theme.compact: VerticalLayout {
                alignment: center;
                IconButton {
                    icon: "refresh";
                    clicked => {
                        root.refresh();
                    }
                }
            }
            if Theme.compact: VerticalLayout {
                alignment: center;
                IconButton {
                    icon: "settings";
                    clicked => {
                        root.settings();
                    }
                }
            }
            if !Theme.compact: VerticalLayout {
                alignment: center;
                PillButton {
                    text: "Refresh";
                    clicked => {
                        root.refresh();
                    }
                }
            }
            if !Theme.compact: VerticalLayout {
                alignment: center;
                PillButton {
                    text: "Settings";
                    clicked => {
                        root.settings();
                    }
                }
            }
            if !Theme.compact: VerticalLayout {
                alignment: center;
                PillButton {
                    text: "Add host";
                    primary: true;
                    clicked => {
                        root.add-host();
                    }
                }
            }
        }

        if root.hosts.length == 0: VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            padding: 32px;
            spacing: 10px;
            Text {
                text: "No hosts yet";
                color: Theme.text;
                font-size: 20px;
                font-weight: 700;
                horizontal-alignment: center;
            }
            Text {
                text: "Hosts running Hermes (or Sunshine/Apollo) on this network show up here automatically. You can also add one by its IP address.";
                color: Theme.muted;
                font-size: Theme.body-size;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
        }

        if root.hosts.length > 0: Flickable {
            vertical-stretch: 1;
            content-width: self.width;
            content-height: Math.ceil(root.hosts.length / root.cols) * (root.tile-h + root.gap) + root.bottom-space;

            for host[i] in root.hosts: HostTile {
                x: root.pad + Math.mod(i, root.cols) * (root.tile-w + root.gap);
                y: 8px + Math.floor(i / root.cols) * (root.tile-h + root.gap);
                width: root.tile-w;
                height: root.tile-h;
                host: host;
                clicked => {
                    root.open-host(host.id);
                }
            }
        }
    }

    if Theme.compact: Fab {
        x: root.width - self.width - 16px;
        y: root.height - self.height - 20px;
        icon: "add";
        text: "Add host";
        clicked => {
            root.add-host();
        }
    }
}

export component AppsPage inherits Rectangle {
    in property <string> host-name;
    in property <string> host-detail;
    in property <[string]> chips;
    in property <[AppCard]> apps;
    in property <bool> loading;
    in property <bool> app-running;
    in property <bool> hermes;
    callback back;
    callback launch(int);
    callback quit-app;
    callback forget;
    callback tools;

    property <bool> menu-open: false;
    property <length> pad: Theme.page-padding;
    property <length> gap: Theme.compact ? 12px : 16px;
    property <length> min-tile: Theme.compact ? 140px : 150px;
    property <int> cols: Math.max(2, Math.floor((root.width - 2 * root.pad + root.gap) / (root.min-tile + root.gap)));
    property <length> tile-w: (root.width - 2 * root.pad - (root.cols - 1) * root.gap) / root.cols;
    property <length> tile-h: root.tile-w * 4 / 3 + 44px;

    VerticalLayout {
        PageHeader {
            title: root.host-name;
            subtitle: root.host-detail;
            show-back: Theme.compact;
            back => {
                root.back();
            }
            if Theme.compact: VerticalLayout {
                alignment: center;
                IconButton {
                    icon: "more";
                    clicked => {
                        root.menu-open = !root.menu-open;
                    }
                }
            }
            if !Theme.compact: VerticalLayout {
                alignment: center;
                PillButton {
                    text: "Back";
                    clicked => {
                        root.back();
                    }
                }
            }
            if !Theme.compact && root.hermes: VerticalLayout {
                alignment: center;
                PillButton {
                    text: "Tools";
                    clicked => {
                        root.tools();
                    }
                }
            }
            if !Theme.compact && root.app-running: VerticalLayout {
                alignment: center;
                PillButton {
                    text: "Quit app";
                    danger: true;
                    clicked => {
                        root.quit-app();
                    }
                }
            }
            if !Theme.compact: VerticalLayout {
                alignment: center;
                PillButton {
                    text: "Forget";
                    clicked => {
                        root.forget();
                    }
                }
            }
        }

        // Host facts; scrolls sideways on narrow screens instead of clipping.
        if root.chips.length > 0: Flickable {
            height: 32px;
            content-height: 32px;
            content-width: chip-row.preferred-width + 2 * root.pad;
            chip-row := HorizontalLayout {
                x: root.pad;
                y: 2px;
                width: self.preferred-width;
                height: 24px;
                spacing: 6px;
                for chip in root.chips: Chip {
                    text: chip;
                    tone: Theme.info;
                }
            }
        }

        // Phones: what's running and a big Quit, instead of a header button.
        if Theme.compact && root.app-running: HorizontalLayout {
            padding-left: root.pad;
            padding-right: root.pad;
            padding-bottom: 8px;
            Rectangle {
                height: 56px;
                border-radius: 14px;
                background: Theme.accent.transparentize(0.86);
                border-width: 1px;
                border-color: Theme.accent.transparentize(0.6);
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 6px;
                    spacing: 8px;
                    Text {
                        text: "An app is running on this host";
                        color: Theme.text;
                        font-size: 14px;
                        font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    VerticalLayout {
                        alignment: center;
                        PillButton {
                            text: "Quit";
                            danger: true;
                            clicked => {
                                root.quit-app();
                            }
                        }
                    }
                }
            }
        }

        if root.loading: VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            HorizontalLayout {
                alignment: center;
                Spinner {
                    width: 36px;
                    height: 36px;
                    indeterminate: true;
                }
            }
        }

        if !root.loading && root.apps.length == 0: VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            padding: 24px;
            Text {
                text: "This host has no apps you are allowed to see.";
                color: Theme.muted;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
        }

        if !root.loading && root.apps.length > 0: Flickable {
            vertical-stretch: 1;
            content-width: self.width;
            content-height: Math.ceil(root.apps.length / root.cols) * (root.tile-h + root.gap) + root.pad;

            for app[i] in root.apps: AppTile {
                x: root.pad + Math.mod(i, root.cols) * (root.tile-w + root.gap);
                y: 8px + Math.floor(i / root.cols) * (root.tile-h + root.gap);
                width: root.tile-w;
                height: root.tile-h;
                app: app;
                clicked => {
                    root.launch(app.id);
                }
            }
        }
    }

    // Overflow menu (phones).
    if root.menu-open: TouchArea {
        clicked => {
            root.menu-open = false;
        }
    }
    if root.menu-open: Rectangle {
        x: root.width - self.width - 8px;
        y: 60px;
        width: 240px;
        height: menu.preferred-height;
        border-radius: 14px;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000090;
        menu := VerticalLayout {
            padding: 6px;
            if root.app-running: MenuItem {
                icon: "stop";
                text: "Quit running app";
                danger: true;
                clicked => {
                    root.menu-open = false;
                    root.quit-app();
                }
            }
            if root.hermes: MenuItem {
                icon: "tools";
                text: "Host tools";
                clicked => {
                    root.menu-open = false;
                    root.tools();
                }
            }
            MenuItem {
                icon: "delete";
                text: "Forget this host";
                clicked => {
                    root.menu-open = false;
                    root.forget();
                }
            }
        }
    }
}

export component SessionPage inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <[string]> lines;
    in property <bool> busy;
    callback back;
    callback quit-app;

    VerticalLayout {
        PageHeader {
            title: root.title;
            subtitle: root.subtitle;
        }

        VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            padding: Theme.page-padding;

            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: Math.min(560px, root.width - 2 * Theme.page-padding);
                    border-radius: Theme.radius;
                    background: Theme.card;
                    border-width: 1px;
                    border-color: Theme.border;

                    VerticalLayout {
                        padding: 24px;
                        spacing: 10px;

                        if root.busy: HorizontalLayout {
                            alignment: center;
                            Spinner {
                                width: 32px;
                                height: 32px;
                                indeterminate: true;
                            }
                        }

                        for line in root.lines: Text {
                            text: line;
                            color: Theme.text;
                            font-size: 14px;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            alignment: end;
                            PillButton {
                                text: "Back to apps";
                                clicked => {
                                    root.back();
                                }
                            }
                            PillButton {
                                text: "Quit app";
                                danger: true;
                                enabled: !root.busy;
                                clicked => {
                                    root.quit-app();
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

component SettingRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> hint;
    spacing: Theme.compact ? 12px : 16px;
    min-height: Theme.compact ? 60px : 48px;
    padding-top: Theme.compact ? 4px : 0px;
    padding-bottom: Theme.compact ? 4px : 0px;

    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        spacing: 2px;
        Text {
            text: root.label;
            color: Theme.text;
            font-size: Theme.body-size;
            font-weight: 600;
            wrap: word-wrap;
        }
        if root.hint != "": Text {
            text: root.hint;
            color: Theme.muted;
            font-size: 12px;
            wrap: word-wrap;
        }
    }

    VerticalLayout {
        alignment: center;
        horizontal-stretch: 0;
        @children
    }
}

component SectionTitle inherits VerticalLayout {
    in property <string> text;
    padding-top: 18px;
    padding-bottom: 4px;
    Text {
        text: root.text;
        color: Theme.accent;
        font-size: 13px;
        font-weight: 700;
    }
}

export component SettingsPage inherits Rectangle {
    in-out property <int> resolution;
    in-out property <int> fps;
    in-out property <float> bitrate-mbps;
    in-out property <int> codec;
    in-out property <int> audio;
    in-out property <bool> hdr;
    in-out property <bool> virtual-display;
    in-out property <bool> host-audio;
    in-out property <bool> gamescope;
    in-out property <bool> optimize;
    in-out property <bool> clipboard;
    in property <string> client-id;
    in property <string> data-dir;
    in property <string> version;
    callback back;
    callback save;

    // Pickers get at most ~45% of the row so labels keep their room.
    property <length> picker-w: Math.min(Theme.compact ? 160px : 170px, (root.width - 2 * Theme.page-padding) * 0.45);
    property <length> slider-w: Math.min(200px, (root.width - 2 * Theme.page-padding) * 0.45);

    VerticalLayout {
        PageHeader {
            title: "Settings";
            subtitle: "Applied to the next session";
            show-back: Theme.compact;
            back => {
                root.back();
            }
            if !Theme.compact: VerticalLayout {
                alignment: center;
                PillButton {
                    text: "Back";
                    clicked => {
                        root.back();
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                PillButton {
                    text: "Save";
                    primary: true;
                    clicked => {
                        root.save();
                    }
                }
            }
        }

        Flickable {
            vertical-stretch: 1;
            content-width: self.width;
            content-height: form.preferred-height;
            form := HorizontalLayout {
                width: root.width;
                alignment: center;
                VerticalLayout {
                    width: Math.min(640px, root.width - 2 * Theme.page-padding);
                    padding-top: 8px;
                    padding-bottom: 32px;
                    spacing: Theme.compact ? 2px : 6px;

                    SectionTitle {
                        text: "Video";
                    }
                    SettingRow {
                        label: "Resolution";
                        ComboBox {
                            width: root.picker-w;
                            model: ["1280 × 720", "1920 × 1080", "2560 × 1440", "3840 × 2160"];
                            current-index <=> root.resolution;
                        }
                    }
                    SettingRow {
                        label: "Frame rate";
                        ComboBox {
                            width: root.picker-w;
                            model: ["30 fps", "60 fps", "90 fps", "120 fps", "144 fps"];
                            current-index <=> root.fps;
                        }
                    }
                    SettingRow {
                        label: "Bitrate";
                        hint: Math.round(root.bitrate-mbps) + " Mbps";
                        Slider {
                            width: root.slider-w;
                            minimum: 5;
                            maximum: 150;
                            value <=> root.bitrate-mbps;
                        }
                    }
                    SettingRow {
                        label: "Codec";
                        hint: "Auto picks the best one both sides support";
                        ComboBox {
                            width: root.picker-w;
                            model: ["Auto", "H.264", "HEVC", "AV1"];
                            current-index <=> root.codec;
                        }
                    }
                    SettingRow {
                        label: "HDR";
                        hint: "Needs HDR support on the host (Hermes-KMS) and this display";
                        Switch {
                            checked <=> root.hdr;
                        }
                    }

                    SectionTitle {
                        text: "Hermes";
                    }
                    SettingRow {
                        label: "Virtual display";
                        hint: "Stream from a virtual display sized to this device";
                        Switch {
                            checked <=> root.virtual-display;
                        }
                    }
                    SettingRow {
                        label: "Gamescope session";
                        hint: "Run games in an isolated Gamescope session when the host supports it";
                        Switch {
                            checked <=> root.gamescope;
                        }
                    }
                    SettingRow {
                        label: "Clipboard sync";
                        Switch {
                            checked <=> root.clipboard;
                        }
                    }

                    SectionTitle {
                        text: "Audio & host";
                    }
                    SettingRow {
                        label: "Speakers";
                        ComboBox {
                            width: root.picker-w;
                            model: ["Stereo", "5.1 surround", "7.1 surround"];
                            current-index <=> root.audio;
                        }
                    }
                    SettingRow {
                        label: "Play audio on host";
                        Switch {
                            checked <=> root.host-audio;
                        }
                    }
                    SettingRow {
                        label: "Optimize game settings";
                        hint: "Let the host adjust its display mode for the stream";
                        Switch {
                            checked <=> root.optimize;
                        }
                    }

                    SectionTitle {
                        text: "About";
                    }
                    Text {
                        text: root.version;
                        color: Theme.text;
                        font-size: 13px;
                    }
                    Text {
                        text: "Client id: " + root.client-id;
                        color: Theme.muted;
                        font-size: 12px;
                    }
                    Text {
                        text: "Data: " + root.data-dir;
                        color: Theme.muted;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}

export struct CommandRow {
    id: int,
    name: string,
    // Hermes wants a confirmation before running it.
    confirm: bool,
    // First tap done; the next one runs it.
    armed: bool,
}

component ToolCard inherits Rectangle {
    in property <string> title;
    border-radius: Theme.radius;
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.border;
    height: card-body.preferred-height;
    card-body := VerticalLayout {
        width: 100%;
        padding: Theme.compact ? 14px : 16px;
        spacing: 10px;
        Text {
            text: root.title;
            color: Theme.text;
            font-size: 16px;
            font-weight: 700;
        }
        @children
    }
}

// Hermes host tools: display recovery, server commands, clipboard,
// this client's permissions and a diagnostics summary.
export component ToolsPage inherits Rectangle {
    in property <string> host-name;
    in property <bool> loading;
    // Error or note for the whole page ("not allowed", "not a Hermes host").
    in property <string> message;
    in property <string> display-status;
    in property <bool> display-allowed: true;
    in property <[CommandRow]> commands;
    in property <bool> commands-allowed: true;
    in property <bool> clipboard-allowed: true;
    in-out property <string> clipboard-text;
    in property <string> permissions;
    in property <[string]> diagnostics;
    in property <bool> busy;
    callback back;
    callback refresh;
    callback recover-display;
    callback run-command(int);
    callback send-clipboard(string);
    callback fetch-clipboard;

    VerticalLayout {
        PageHeader {
            title: "Host tools";
            subtitle: root.host-name;
            show-back: Theme.compact;
            back => {
                root.back();
            }
            if root.busy || root.loading: VerticalLayout {
                alignment: center;
                Spinner {
                    width: 22px;
                    height: 22px;
                    indeterminate: true;
                }
            }
            if Theme.compact: VerticalLayout {
                alignment: center;
                IconButton {
                    icon: "refresh";
                    clicked => {
                        root.refresh();
                    }
                }
            }
            if !Theme.compact: VerticalLayout {
                alignment: center;
                PillButton {
                    text: "Refresh";
                    clicked => {
                        root.refresh();
                    }
                }
            }
            if !Theme.compact: VerticalLayout {
                alignment: center;
                PillButton {
                    text: "Back";
                    clicked => {
                        root.back();
                    }
                }
            }
        }

        Flickable {
            vertical-stretch: 1;
            content-width: self.width;
            content-height: tools-form.preferred-height;
            tools-form := HorizontalLayout {
                width: root.width;
                alignment: center;
                VerticalLayout {
                    width: Math.min(640px, root.width - 2 * Theme.page-padding);
                    padding-top: 8px;
                    padding-bottom: 32px;
                    spacing: 12px;

                    if root.message != "": Text {
                        text: root.message;
                        color: Theme.warn;
                        wrap: word-wrap;
                    }

                    ToolCard {
                        title: "Display";
                        Text {
                            text: root.loading ? "Checking…" : root.display-status;
                            color: Theme.muted;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            alignment: start;
                            PillButton {
                                text: "Recover display";
                                enabled: root.display-allowed && !root.busy;
                                clicked => {
                                    root.recover-display();
                                }
                            }
                        }
                    }

                    ToolCard {
                        title: "Server commands";
                        if !root.loading && root.commands.length == 0: Text {
                            text: root.commands-allowed ? "No commands are configured on the host." : "This device may not run server commands.";
                            color: Theme.muted;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                        for cmd in root.commands: HorizontalLayout {
                            spacing: 10px;
                            min-height: Theme.control-height;
                            Text {
                                text: cmd.name;
                                color: Theme.text;
                                font-size: Theme.body-size;
                                vertical-alignment: center;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                            }
                            VerticalLayout {
                                alignment: center;
                                PillButton {
                                    text: cmd.armed ? "Confirm" : "Run";
                                    primary: cmd.armed;
                                    danger: cmd.confirm && !cmd.armed;
                                    enabled: root.commands-allowed && !root.busy;
                                    clicked => {
                                        root.run-command(cmd.id);
                                    }
                                }
                            }
                        }
                    }

                    ToolCard {
                        title: "Clipboard";
                        Text {
                            text: root.clipboard-allowed ? "Send text to the host's clipboard, or fetch what it holds." : "Clipboard sync is not allowed for this device.";
                            color: Theme.muted;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                        TextEdit {
                            height: 96px;
                            text <=> root.clipboard-text;
                            enabled: root.clipboard-allowed;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            PillButton {
                                text: "Send to host";
                                primary: true;
                                enabled: root.clipboard-allowed && !root.busy && root.clipboard-text != "";
                                clicked => {
                                    root.send-clipboard(root.clipboard-text);
                                }
                            }
                            PillButton {
                                text: "Get from host";
                                enabled: root.clipboard-allowed && !root.busy;
                                clicked => {
                                    root.fetch-clipboard();
                                }
                            }
                        }
                    }

                    ToolCard {
                        title: "This device";
                        Text {
                            text: root.permissions == "" ? "…" : root.permissions;
                            color: Theme.muted;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }

                    if root.diagnostics.length > 0: ToolCard {
                        title: "Diagnostics";
                        for line in root.diagnostics: Text {
                            text: line;
                            color: Theme.muted;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}
