import { Spinner } from "std-widgets.slint";
import { Theme, Icon, IconButton, MenuItem } from "theme.slint";

// Small pill for the keyboard bar's shortcut keys.
component KeyChip inherits Rectangle {
    in property <string> text;
    callback clicked;
    height: Theme.compact ? 40px : 32px;
    min-width: label.preferred-width + 24px;
    preferred-width: label.preferred-width + 24px;
    horizontal-stretch: 0;
    border-radius: 8px;
    background: touch.pressed ? Theme.card-hover : Theme.card;
    border-width: 1px;
    border-color: Theme.border;
    label := Text {
        text: root.text;
        color: Theme.text;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// One control of the on-screen controller, laid out by the app (Rust also
// decides which finger presses what; these are only drawn).
// kind: 0 round button, 1 rectangular button, 2 stick, 3 d-pad.
export struct PadControl {
    kind: int,
    label: string,
    x: length,
    y: length,
    w: length,
    h: length,
    pressed: bool,
    knob-x: length,
    knob-y: length,
    // d-pad: held directions
    up: bool,
    down: bool,
    left: bool,
    right: bool,
}

component PadArrow inherits Rectangle {
    in property <bool> lit;
    width: 34%;
    height: 34%;
    border-radius: 6px;
    background: root.lit ? #ffffff80 : #ffffff22;
    border-width: 1.5px;
    border-color: #ffffffa0;
}

// Full-window video with input capture. Keyboard, mouse and touch go to the
// host; Ctrl+Alt+Shift+Q disconnects, Ctrl+Alt+Shift+S toggles statistics.
// Touch acts as a trackpad (relative cursor, tap = click, hold = right
// click, tap-then-drag = drag) unless direct mode is chosen.
export component StreamView inherits Rectangle {
    in property <image> frame;
    in property <string> stats;
    // Shown over the video while there is no picture yet.
    in property <string> status;
    in property <bool> show-stats: true;
    in property <bool> fullscreen;
    // 0 trackpad, 1 mouse, 2 touchscreen
    in property <int> touch-mode: 0;
    callback cycle-touch-mode();
    // On-screen controller.
    in property <bool> pad-visible: false;
    // Hermes host with clipboard support: one-off send / fetch in the menu.
    in property <bool> clipboard-actions: false;
    callback clipboard-send();
    callback clipboard-fetch();
    in property <[PadControl]> pad-controls;
    callback toggle-pad();
    // The view's size, for the controller's layout.
    callback view-size(float, float);
    // Pinch-to-zoom and pan (two fingers) while zoom mode is on.
    in property <bool> zoom-mode: false;
    in property <float> zoom: 1;
    in property <float> pan-x: 0;
    in property <float> pan-y: 0;
    callback toggle-zoom();
    // 0 fit, 1 fill (crop), 2 stretch.
    in property <int> video-scale: 0;
    callback cycle-scale();
    // The on-screen keyboard (Android) is up; the shortcut row shows.
    in-out property <bool> keyboard-open: false;
    // Always show the menu button (otherwise Back / Escape open the menu).
    in property <bool> show-menu-button: true;
    // Whether "Keyboard" opens an on-screen keyboard (phones).
    in property <bool> soft-keyboard: false;
    // Short-lived note at the bottom (e.g. how Hermes serves the stream).
    in property <string> banner;

    // text, pressed, repeat, ctrl, alt, shift, meta
    callback key-event(string, bool, bool, bool, bool, bool, bool);
    // kind (0 down, 1 up, 2 move, 3 cancel), button (1 left, 2 middle,
    // 3 right), x, y relative to the video, video width, height, finger id
    // (0 = mouse), x, y relative to the view
    callback pointer(int, int, float, float, float, float, int, float, float);
    callback scrolled(float, float);
    callback special-key(string);
    callback toggle-stats();
    callback toggle-fullscreen();
    callback request-keyframe();
    callback disconnect();
    callback quit-app();

    in-out property <bool> menu-open: false;
    property <float> frame-w: root.frame.width > 0 ? root.frame.width : 16;
    property <float> frame-h: root.frame.height > 0 ? root.frame.height : 9;
    property <float> scale: root.video-scale == 1
        ? max(root.width / 1px / root.frame-w, root.height / 1px / root.frame-h)
        : min(root.width / 1px / root.frame-w, root.height / 1px / root.frame-h);
    property <[{id: string, label: string}]> keys: [
        { id: "esc", label: "Esc" },
        { id: "tab", label: "Tab" },
        { id: "enter", label: "Enter" },
        { id: "backspace", label: "⌫" },
        { id: "win", label: "Win" },
        { id: "alt-tab", label: "Alt+Tab" },
        { id: "alt-f4", label: "Alt+F4" },
    ];

    background: black;
    // Fill mode makes the picture larger than the view.
    clip: true;

    init => {
        root.view-size(self.width / 1px, self.height / 1px);
    }
    changed width => {
        root.view-size(self.width / 1px, self.height / 1px);
    }
    changed height => {
        root.view-size(self.width / 1px, self.height / 1px);
    }

    changed keyboard-open => {
        if (!root.keyboard-open) {
            focus.focus();
        }
    }

    focus := FocusScope {
        width: 100%;
        height: 100%;
        init => {
            self.focus();
        }
        key-pressed(event) => {
            // Android back: close the keyboard bar, else toggle the menu.
            if (event.text == Key.Back) {
                if (root.keyboard-open) {
                    root.keyboard-open = false;
                } else {
                    root.menu-open = !root.menu-open;
                }
                return accept;
            }
            root.key-event(event.text, true, event.repeat, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
            accept
        }
        key-released(event) => {
            if (event.text == Key.Back) {
                return accept;
            }
            root.key-event(event.text, false, false, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
            accept
        }

        video := Rectangle {
            width: (root.video-scale == 2 ? parent.width : root.frame-w * root.scale * 1px) * root.zoom;
            height: (root.video-scale == 2 ? parent.height : root.frame-h * root.scale * 1px) * root.zoom;
            x: (parent.width - self.width) / 2 + root.pan-x * 1px;
            // Portrait with the on-screen controller: the picture goes to
            // the top, the controller under it (same ratio as the layout).
            y: (root.pad-visible && parent.height >= parent.width * 1.3 ? (self.height / root.zoom - self.height) / 2 : (parent.height - self.height) / 2) + root.pan-y * 1px;

            Image {
                width: 100%;
                height: 100%;
                source: root.frame;
                image-fit: fill;
            }
        }

        // The whole view takes input: in trackpad mode the black bars are
        // part of the pad, and absolute positions are clamped to the video.
        TouchArea {
            mouse-cursor: none;
            pointer-event(event) => {
                root.pointer(
                    event.kind == PointerEventKind.down ? 0
                        : event.kind == PointerEventKind.up ? 1
                        : event.kind == PointerEventKind.move ? 2 : 3,
                    event.button == PointerEventButton.left ? 1
                        : event.button == PointerEventButton.middle ? 2
                        : event.button == PointerEventButton.right ? 3 : 0,
                    (self.mouse-x - video.x) / 1px,
                    (self.mouse-y - video.y) / 1px,
                    video.width / 1px,
                    video.height / 1px,
                    event.touch-finger-id,
                    self.mouse-x / 1px,
                    self.mouse-y / 1px);
            }
            scroll-event(event) => {
                root.scrolled(event.delta-x / 1px, event.delta-y / 1px);
                accept
            }
        }
    }

    // On-screen controller (drawn only; touches reach the area above).
    if root.pad-visible: Rectangle {
        width: 100%;
        height: 100%;
        for c in root.pad-controls: Rectangle {
            x: c.x - c.w / 2;
            y: c.y - c.h / 2;
            width: c.w;
            height: c.h;

            if c.kind == 0 || c.kind == 1: Rectangle {
                width: 100%;
                height: 100%;
                border-radius: c.kind == 0 ? self.height / 2 : 10px;
                background: c.pressed ? #ffffff70 : #ffffff24;
                border-width: 1.5px;
                border-color: #ffffffa0;
                Text {
                    width: 100%;
                    height: 100%;
                    text: c.label;
                    color: white;
                    font-size: min(c.h * 0.42, 20px);
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            if c.kind == 2: Rectangle {
                width: 100%;
                height: 100%;
                border-radius: self.width / 2;
                background: #ffffff18;
                border-width: 1.5px;
                border-color: #ffffff70;
                Rectangle {
                    width: parent.width * 0.46;
                    height: self.width;
                    x: (parent.width - self.width) / 2 + c.knob-x;
                    y: (parent.height - self.height) / 2 + c.knob-y;
                    border-radius: self.width / 2;
                    background: c.pressed ? #ffffff90 : #ffffff50;
                }
            }
            if c.kind == 3: Rectangle {
                width: 100%;
                height: 100%;
                PadArrow {
                    x: (parent.width - self.width) / 2;
                    y: 0;
                    lit: c.up;
                }
                PadArrow {
                    x: (parent.width - self.width) / 2;
                    y: parent.height - self.height;
                    lit: c.down;
                }
                PadArrow {
                    x: 0;
                    y: (parent.height - self.height) / 2;
                    lit: c.left;
                }
                PadArrow {
                    x: parent.width - self.width;
                    y: (parent.height - self.height) / 2;
                    lit: c.right;
                }
            }
        }
    }

    if root.status != "": VerticalLayout {
        width: 100%;
        height: 100%;
        alignment: center;
        spacing: 14px;
        HorizontalLayout {
            alignment: center;
            Spinner {
                width: 36px;
                height: 36px;
                indeterminate: true;
            }
        }
        HorizontalLayout {
            alignment: center;
            Text {
                width: Math.min(root.width - 48px, 520px);
                horizontal-alignment: center;
                wrap: word-wrap;
                text: root.status;
                color: Theme.text;
                font-size: 15px;
            }
        }
    }

    if root.show-stats && root.stats != "" && !root.keyboard-open: Rectangle {
        x: 12px;
        y: 12px;
        // Wraps on narrow screens instead of running under the menu button.
        property <length> max-w: root.width - 84px;
        width: Theme.compact ? self.max-w : Math.min(stats-text.preferred-width + 20px, self.max-w);
        height: stats-text.preferred-height + 12px;
        border-radius: 10px;
        background: #000000a8;
        stats-text := Text {
            x: 10px;
            y: 6px;
            width: parent.width - 20px;
            text: root.stats;
            color: #e6e8ee;
            font-size: 12px;
            wrap: word-wrap;
        }
    }

    if root.banner != "" && !root.keyboard-open: Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height - self.height - 24px;
        width: Math.min(banner-text.preferred-width + 32px, root.width - 32px);
        height: banner-text.preferred-height + 20px;
        border-radius: 12px;
        background: #000000c0;
        banner-text := Text {
            x: 16px;
            y: 10px;
            width: parent.width - 32px;
            text: root.banner;
            color: #e6e8ee;
            font-size: 13px;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
    }

    // Shortcut keys while the keyboard is open: a slim row at the top, so
    // the on-screen keyboard (which types straight into the host) can't
    // cover it.
    if root.keyboard-open: Rectangle {
        x: 8px;
        y: 8px;
        width: root.width - (root.show-menu-button ? Theme.control-height + 28px : 16px);
        height: key-bar.preferred-height;
        border-radius: 14px;
        background: Theme.surface.transparentize(0.08);
        border-width: 1px;
        border-color: Theme.border;

        key-bar := HorizontalLayout {
            padding: 6px;
            spacing: 6px;
            Flickable {
                height: Theme.compact ? 40px : 32px;
                content-height: self.height;
                content-width: key-row.preferred-width;
                key-row := HorizontalLayout {
                    width: self.preferred-width;
                    height: parent.height;
                    spacing: 6px;
                    for key in root.keys: KeyChip {
                        text: key.label;
                        clicked => {
                            root.special-key(key.id);
                        }
                    }
                }
            }
            IconButton {
                icon: "close";
                clicked => {
                    root.keyboard-open = false;
                }
            }
        }
    }

    // Menu handle, top right: only when asked for in Settings (Back or
    // Escape open the menu otherwise), or while the menu is open.
    // With the on-screen controller it moves to the top centre, off the
    // triggers.
    if root.show-menu-button || root.menu-open: Rectangle {
        x: root.pad-visible && !root.keyboard-open ? (parent.width - self.width) / 2 : parent.width - self.width - 12px;
        y: 12px;
        width: Theme.control-height;
        height: Theme.control-height;
        border-radius: self.height / 2;
        background: handle.has-hover || root.menu-open ? #ffffff30 : #00000070;
        animate background { duration: 120ms; }
        Icon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            name: root.menu-open ? "close" : "menu";
            tint: white;
        }
        // On press, not click: nothing under the finger can swallow it.
        handle := TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.menu-open = !root.menu-open;
                }
            }
        }
    }

    if root.menu-open: Rectangle {
        x: root.pad-visible && !root.keyboard-open ? (parent.width - self.width) / 2 : parent.width - self.width - 12px;
        y: Theme.control-height + 20px;
        width: 260px;
        // Fits under the handle; the list scrolls when the screen is short.
        height: Math.min(menu-top.preferred-height + menu-list.preferred-height + 1px, root.height - self.y - 12px);
        clip: true;
        border-radius: Theme.radius;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000090;

        // Leaving the stream stays in reach at the top.
        menu-top := VerticalLayout {
            y: 0;
            width: parent.width;
            height: self.preferred-height;
            padding: 6px;
            padding-bottom: 4px;
            MenuItem {
                icon: "logout";
                text: "Disconnect";
                clicked => {
                    root.menu-open = false;
                    root.disconnect();
                }
            }
            MenuItem {
                icon: "stop";
                text: "Quit app";
                danger: true;
                clicked => {
                    root.menu-open = false;
                    root.quit-app();
                }
            }
        }
        Rectangle {
            y: menu-top.height;
            x: 10px;
            width: parent.width - 20px;
            height: 1px;
            background: Theme.border;
        }
        Flickable {
            y: menu-top.height + 1px;
            width: parent.width;
            height: parent.height - self.y;
            content-width: self.width;
            content-height: menu-list.preferred-height;
            menu-list := VerticalLayout {
                width: 260px;
                height: self.preferred-height;
                padding: 6px;
                MenuItem {
                    icon: "keyboard";
                    text: root.keyboard-open ? "Hide keyboard" : root.soft-keyboard ? "Keyboard (3-finger tap)" : "Shortcut keys";
                    clicked => {
                        root.keyboard-open = !root.keyboard-open;
                        root.menu-open = false;
                    }
                }
                if root.clipboard-actions: MenuItem {
                    icon: "clipboard";
                    text: "Send clipboard to host";
                    clicked => {
                        root.clipboard-send();
                        root.menu-open = false;
                    }
                }
                if root.clipboard-actions: MenuItem {
                    icon: "clipboard";
                    text: "Get host's clipboard";
                    clicked => {
                        root.clipboard-fetch();
                        root.menu-open = false;
                    }
                }
                MenuItem {
                    icon: "mouse";
                    text: root.touch-mode == 0 ? "Touch: trackpad" : root.touch-mode == 1 ? "Touch: mouse" : "Touch: touchscreen";
                    clicked => {
                        root.cycle-touch-mode();
                    }
                }
                MenuItem {
                    icon: "play";
                    text: root.pad-visible ? "Hide on-screen controller" : "On-screen controller";
                    clicked => {
                        root.toggle-pad();
                        root.menu-open = false;
                    }
                }
                MenuItem {
                    icon: "fullscreen";
                    text: root.zoom-mode ? "Zoom: on (pinch, two-finger pan)" : "Zoom";
                    clicked => {
                        root.toggle-zoom();
                        root.menu-open = false;
                    }
                }
                MenuItem {
                    icon: "monitor";
                    text: root.video-scale == 0 ? "Picture: fit" : root.video-scale == 1 ? "Picture: fill" : "Picture: stretch";
                    clicked => {
                        root.cycle-scale();
                    }
                }
                MenuItem {
                    icon: "stats";
                    text: root.show-stats ? "Hide statistics" : "Show statistics";
                    clicked => {
                        root.toggle-stats();
                    }
                }
                MenuItem {
                    icon: "refresh";
                    text: "Fix picture (new keyframe)";
                    clicked => {
                        root.request-keyframe();
                        root.menu-open = false;
                    }
                }
                MenuItem {
                    icon: "fullscreen";
                    text: root.fullscreen ? "Leave full screen" : "Full screen";
                    clicked => {
                        root.toggle-fullscreen();
                        root.menu-open = false;
                    }
                }
                if !Theme.compact: Text {
                    text: "Ctrl+Alt+Shift+Q disconnects";
                    color: Theme.muted;
                    font-size: 11px;
                    horizontal-alignment: center;
                }
            }
        }
    }
}
