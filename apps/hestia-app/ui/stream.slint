import { LineEdit, Spinner } from "std-widgets.slint";
import { Theme, Icon, IconButton, MenuItem } from "theme.slint";

// Small pill for the keyboard bar's shortcut keys.
component KeyChip inherits Rectangle {
    in property <string> text;
    callback clicked;
    height: Theme.compact ? 40px : 32px;
    min-width: label.preferred-width + 24px;
    preferred-width: label.preferred-width + 24px;
    horizontal-stretch: 0;
    border-radius: 8px;
    background: touch.pressed ? Theme.card-hover : Theme.card;
    border-width: 1px;
    border-color: Theme.border;
    label := Text {
        text: root.text;
        color: Theme.text;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Full-window video with input capture. Keyboard, mouse and touch go to the
// host; Ctrl+Alt+Shift+Q disconnects, Ctrl+Alt+Shift+S toggles statistics.
// Touch acts as a trackpad (relative cursor, tap = click, hold = right
// click, tap-then-drag = drag) unless direct mode is chosen.
export component StreamView inherits Rectangle {
    in property <image> frame;
    in property <string> stats;
    // Shown over the video while there is no picture yet.
    in property <string> status;
    in property <bool> show-stats: true;
    in property <bool> fullscreen;
    in property <bool> trackpad: true;
    // 0 fit, 1 fill (crop), 2 stretch.
    in property <int> video-scale: 0;
    callback cycle-scale();
    in-out property <bool> keyboard-open: false;
    // Short-lived note at the bottom (e.g. how Hermes serves the stream).
    in property <string> banner;

    // text, pressed, repeat, ctrl, alt, shift, meta
    callback key-event(string, bool, bool, bool, bool, bool, bool);
    // kind (0 down, 1 up, 2 move, 3 cancel), button (1 left, 2 middle,
    // 3 right), x, y relative to the video, video width, height, is touch
    callback pointer(int, int, float, float, float, float, bool);
    callback scrolled(float, float);
    callback text-edited(string);
    callback text-enter();
    callback special-key(string);
    callback toggle-stats();
    callback toggle-fullscreen();
    callback toggle-trackpad();
    callback request-keyframe();
    callback disconnect();
    callback quit-app();

    property <bool> menu-open: false;
    property <float> frame-w: root.frame.width > 0 ? root.frame.width : 16;
    property <float> frame-h: root.frame.height > 0 ? root.frame.height : 9;
    property <float> scale: root.video-scale == 1
        ? max(root.width / 1px / root.frame-w, root.height / 1px / root.frame-h)
        : min(root.width / 1px / root.frame-w, root.height / 1px / root.frame-h);
    property <[{id: string, label: string}]> keys: [
        { id: "esc", label: "Esc" },
        { id: "tab", label: "Tab" },
        { id: "enter", label: "Enter" },
        { id: "backspace", label: "⌫" },
        { id: "win", label: "Win" },
        { id: "alt-tab", label: "Alt+Tab" },
        { id: "alt-f4", label: "Alt+F4" },
    ];

    background: black;
    // Fill mode makes the picture larger than the view.
    clip: true;

    changed keyboard-open => {
        if (!root.keyboard-open) {
            focus.focus();
        }
    }

    focus := FocusScope {
        width: 100%;
        height: 100%;
        init => {
            self.focus();
        }
        key-pressed(event) => {
            // Android back: close the keyboard bar, else toggle the menu.
            if (event.text == Key.Back) {
                if (root.keyboard-open) {
                    root.keyboard-open = false;
                } else {
                    root.menu-open = !root.menu-open;
                }
                return accept;
            }
            root.key-event(event.text, true, event.repeat, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
            accept
        }
        key-released(event) => {
            if (event.text == Key.Back) {
                return accept;
            }
            root.key-event(event.text, false, false, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
            accept
        }

        video := Rectangle {
            width: root.video-scale == 2 ? parent.width : root.frame-w * root.scale * 1px;
            height: root.video-scale == 2 ? parent.height : root.frame-h * root.scale * 1px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            Image {
                width: 100%;
                height: 100%;
                source: root.frame;
                image-fit: fill;
            }
        }

        // The whole view takes input: in trackpad mode the black bars are
        // part of the pad, and absolute positions are clamped to the video.
        TouchArea {
            mouse-cursor: none;
            pointer-event(event) => {
                root.pointer(
                    event.kind == PointerEventKind.down ? 0
                        : event.kind == PointerEventKind.up ? 1
                        : event.kind == PointerEventKind.move ? 2 : 3,
                    event.button == PointerEventButton.left ? 1
                        : event.button == PointerEventButton.middle ? 2
                        : event.button == PointerEventButton.right ? 3 : 0,
                    (self.mouse-x - video.x) / 1px,
                    (self.mouse-y - video.y) / 1px,
                    video.width / 1px,
                    video.height / 1px,
                    event.touch-finger-id != 0);
            }
            scroll-event(event) => {
                root.scrolled(event.delta-x / 1px, event.delta-y / 1px);
                accept
            }
        }
    }

    if root.status != "": VerticalLayout {
        width: 100%;
        height: 100%;
        alignment: center;
        spacing: 14px;
        HorizontalLayout {
            alignment: center;
            Spinner {
                width: 36px;
                height: 36px;
                indeterminate: true;
            }
        }
        Text {
            horizontal-alignment: center;
            text: root.status;
            color: Theme.text;
            font-size: 15px;
        }
    }

    if root.show-stats && root.stats != "" && !root.keyboard-open: Rectangle {
        x: 12px;
        y: 12px;
        // Wraps on narrow screens instead of running under the menu button.
        property <length> max-w: root.width - 84px;
        width: Theme.compact ? self.max-w : Math.min(stats-text.preferred-width + 20px, self.max-w);
        height: stats-text.preferred-height + 12px;
        border-radius: 10px;
        background: #000000a8;
        stats-text := Text {
            x: 10px;
            y: 6px;
            width: parent.width - 20px;
            text: root.stats;
            color: #e6e8ee;
            font-size: 12px;
            wrap: word-wrap;
        }
    }

    if root.banner != "" && !root.keyboard-open: Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height - self.height - 24px;
        width: Math.min(banner-text.preferred-width + 32px, root.width - 32px);
        height: banner-text.preferred-height + 20px;
        border-radius: 12px;
        background: #000000c0;
        banner-text := Text {
            x: 16px;
            y: 10px;
            width: parent.width - 32px;
            text: root.banner;
            color: #e6e8ee;
            font-size: 13px;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
    }

    // Keyboard bar: at the top, so the on-screen keyboard can't cover it.
    if root.keyboard-open: Rectangle {
        x: 8px;
        y: 8px;
        width: root.width - Theme.control-height - 28px;
        height: bar.preferred-height;
        border-radius: 14px;
        background: Theme.surface.transparentize(0.08);
        border-width: 1px;
        border-color: Theme.border;

        bar := VerticalLayout {
            width: 100%;
            padding: 8px;
            spacing: 8px;
            Flickable {
                height: Theme.compact ? 40px : 32px;
                content-height: self.height;
                content-width: key-row.preferred-width;
                key-row := HorizontalLayout {
                    width: self.preferred-width;
                    height: parent.height;
                    spacing: 6px;
                    for key in root.keys: KeyChip {
                        text: key.label;
                        clicked => {
                            root.special-key(key.id);
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 6px;
                LineEdit {
                    placeholder-text: "Type to send to the host";
                    init => {
                        self.focus();
                    }
                    edited(text) => {
                        root.text-edited(text);
                    }
                    accepted(text) => {
                        root.text-enter();
                        self.text = "";
                    }
                }
                IconButton {
                    icon: "close";
                    clicked => {
                        root.keyboard-open = false;
                    }
                }
            }
        }
    }

    // Menu handle, top right.
    Rectangle {
        x: parent.width - self.width - 12px;
        y: 12px;
        width: Theme.control-height;
        height: Theme.control-height;
        border-radius: self.height / 2;
        background: handle.has-hover || root.menu-open ? #ffffff30 : #00000070;
        animate background { duration: 120ms; }
        Icon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            name: root.menu-open ? "close" : "menu";
            tint: white;
        }
        handle := TouchArea {
            clicked => {
                root.menu-open = !root.menu-open;
            }
        }
    }

    if root.menu-open: Rectangle {
        x: parent.width - self.width - 12px;
        y: Theme.control-height + 20px;
        width: 260px;
        height: menu.preferred-height;
        border-radius: Theme.radius;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000090;

        menu := VerticalLayout {
            width: 100%;
            padding: 6px;
            MenuItem {
                icon: "keyboard";
                text: root.keyboard-open ? "Hide keyboard" : "Keyboard & shortcuts";
                clicked => {
                    root.keyboard-open = !root.keyboard-open;
                    root.menu-open = false;
                }
            }
            MenuItem {
                icon: "mouse";
                text: root.trackpad ? "Touch: trackpad" : "Touch: direct";
                clicked => {
                    root.toggle-trackpad();
                }
            }
            MenuItem {
                icon: "monitor";
                text: root.video-scale == 0 ? "Picture: fit" : root.video-scale == 1 ? "Picture: fill" : "Picture: stretch";
                clicked => {
                    root.cycle-scale();
                }
            }
            MenuItem {
                icon: "stats";
                text: root.show-stats ? "Hide statistics" : "Show statistics";
                clicked => {
                    root.toggle-stats();
                }
            }
            MenuItem {
                icon: "refresh";
                text: "Fix picture (new keyframe)";
                clicked => {
                    root.request-keyframe();
                    root.menu-open = false;
                }
            }
            MenuItem {
                icon: "fullscreen";
                text: root.fullscreen ? "Leave full screen" : "Full screen";
                clicked => {
                    root.toggle-fullscreen();
                    root.menu-open = false;
                }
            }
            MenuItem {
                icon: "logout";
                text: "Disconnect";
                clicked => {
                    root.menu-open = false;
                    root.disconnect();
                }
            }
            MenuItem {
                icon: "stop";
                text: "Quit app";
                danger: true;
                clicked => {
                    root.menu-open = false;
                    root.quit-app();
                }
            }
            if !Theme.compact: Text {
                text: "Ctrl+Alt+Shift+Q disconnects";
                color: Theme.muted;
                font-size: 11px;
                horizontal-alignment: center;
            }
        }
    }
}
