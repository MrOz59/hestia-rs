// Visual language: dark, warm "hearth" accent (Hestia), soft cards.

export global Theme {
    out property <color> bg: #0d0f13;
    out property <color> surface: #14171d;
    out property <color> card: #1a1e26;
    out property <color> card-hover: #222733;
    out property <color> border: #282e3b;
    out property <color> text: #eceef3;
    out property <color> muted: #8e95a3;
    out property <color> accent: #ff7a3d;
    out property <color> accent-hover: #ff9160;
    out property <color> on-accent: #1d0f07;
    out property <color> ok: #3ecf8e;
    out property <color> warn: #f2b33d;
    out property <color> danger: #f06262;
    out property <color> info: #8ab4ff;
    out property <length> radius: 16px;

    // Phones and narrow windows: set by the window from its width.
    in-out property <bool> compact: false;
    out property <length> page-padding: compact ? 16px : 20px;
    // Touch targets: 48px (Material minimum) on phones.
    out property <length> control-height: compact ? 48px : 40px;
    out property <length> body-size: compact ? 15px : 14px;
}

// Material Icons (Apache License 2.0), 24x24 view box.
export component Icon inherits Path {
    in property <string> name;
    in property <color> tint: Theme.text;
    width: 22px;
    height: 22px;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: root.tint;
    commands: root.name == "back" ? "M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"
        : root.name == "refresh" ? "M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
        : root.name == "add" ? "M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"
        : root.name == "more" ? "M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"
        : root.name == "close" ? "M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
        : root.name == "settings" ? "M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"
        : root.name == "stop" ? "M6 6h12v12H6z"
        : root.name == "logout" ? "M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"
        : root.name == "fullscreen" ? "M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"
        : root.name == "stats" ? "M5 9.2h3V19H5zM10.6 5h2.8v14h-2.8zm5.6 8H19v6h-2.8z"
        : root.name == "delete" ? "M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
        : root.name == "keyboard" ? "M20 5H4c-1.1 0-1.99.9-1.99 2L2 17c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm-9 3h2v2h-2V8zm0 3h2v2h-2v-2zM8 8h2v2H8V8zm0 3h2v2H8v-2zm-1 2H5v-2h2v2zm0-3H5V8h2v2zm9 7H8v-2h8v2zm0-4h-2v-2h2v2zm0-3h-2V8h2v2zm3 3h-2v-2h2v2zm0-3h-2V8h2v2z"
        : root.name == "mouse" ? "M13 1.07V9h7c0-4.08-3.05-7.44-7-7.93zM4 15c0 4.42 3.58 8 8 8s8-3.58 8-8v-4H4v4zm7-13.93C7.05 1.56 4 4.92 4 9h7V1.07z"
        : root.name == "tools" ? "M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z"
        : root.name == "play" ? "M8 5v14l11-7z"
        : root.name == "clipboard" ? "M19 2h-4.18C14.4.84 13.3 0 12 0c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm7 18H5V4h2v3h10V4h2v16z"
        : root.name == "monitor" ? "M21 2H3c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h7v2H8v2h8v-2h-2v-2h7c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H3V4h18v12z"
        : "M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"; // menu
}

// Round icon-only button; 48px on phones.
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked;

    // Keyboard / TV remote: focusable (Tab, or `want-focus`), Return or
    // Space presses it; arrows and Back go to `nav` (true: handled).
    in property <bool> want-focus;
    callback nav(string) -> bool;
    out property <bool> focused: fs.has-focus;
    init => {
        if (self.want-focus) {
            fs.focus();
        }
    }
    changed want-focus => {
        if (self.want-focus) {
            fs.focus();
        }
    }
    fs := FocusScope {
        width: 0;
        height: 0;
        key-pressed(event) => {
            if (root.enabled && (event.text == Key.Return || event.text == " ")) {
                root.clicked();
                return accept;
            }
            if (root.nav(event.text)) {
                root.nav-took-back = event.text == Key.Back;
                return accept;
            }
            return reject;
        }
        key-released(event) => {
            // Android sends Back's release separately; keep it here when
            // the press was handled.
            if (event.text == Key.Back && root.nav-took-back) {
                root.nav-took-back = false;
                return accept;
            }
            return reject;
        }
    }
    property <bool> nav-took-back;

    width: Theme.control-height;
    height: Theme.control-height;
    horizontal-stretch: 0;
    border-radius: self.height / 2;
    border-width: fs.has-focus ? 2px : 0px;
    border-color: root.primary ? Theme.text : Theme.accent;
    opacity: root.enabled ? 1.0 : 0.45;
    background: root.primary
        ? (touch.pressed || touch.has-hover ? Theme.accent-hover : Theme.accent)
        : (touch.pressed || fs.has-focus ? Theme.card-hover : (touch.has-hover ? Theme.card : transparent));
    animate background { duration: 120ms; }

    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        name: root.icon;
        tint: root.primary ? Theme.on-accent : Theme.text;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Floating action button: icon + label, for the main action on phones.
export component Fab inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    callback clicked;

    // Keyboard / TV remote: focusable (Tab, or `want-focus`), Return or
    // Space presses it; arrows and Back go to `nav` (true: handled).
    in property <bool> want-focus;
    callback nav(string) -> bool;
    out property <bool> focused: fs.has-focus;
    init => {
        if (self.want-focus) {
            fs.focus();
        }
    }
    changed want-focus => {
        if (self.want-focus) {
            fs.focus();
        }
    }
    fs := FocusScope {
        width: 0;
        height: 0;
        key-pressed(event) => {
            if (true && (event.text == Key.Return || event.text == " ")) {
                root.clicked();
                return accept;
            }
            if (root.nav(event.text)) {
                root.nav-took-back = event.text == Key.Back;
                return accept;
            }
            return reject;
        }
        key-released(event) => {
            // Android sends Back's release separately; keep it here when
            // the press was handled.
            if (event.text == Key.Back && root.nav-took-back) {
                root.nav-took-back = false;
                return accept;
            }
            return reject;
        }
    }
    property <bool> nav-took-back;

    width: label.preferred-width + 72px;
    height: 56px;
    border-radius: 18px;
    border-width: fs.has-focus ? 3px : 0px;
    border-color: Theme.text;
    background: touch.pressed ? Theme.accent-hover : Theme.accent;
    drop-shadow-blur: 16px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: #00000080;

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 22px;
        spacing: 10px;
        alignment: center;
        VerticalLayout {
            alignment: center;
            Icon {
                name: root.icon;
                tint: Theme.on-accent;
            }
        }
        label := Text {
            text: root.text;
            color: Theme.on-accent;
            font-size: 15px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Full-width row in an action menu (icon + label).
export component MenuItem inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <bool> danger: false;
    callback clicked;

    // Keyboard / TV remote: focusable (Tab, or `want-focus`), Return or
    // Space presses it; arrows and Back go to `nav` (true: handled).
    in property <bool> want-focus;
    callback nav(string) -> bool;
    out property <bool> focused: fs.has-focus;
    init => {
        if (self.want-focus) {
            fs.focus();
        }
    }
    changed want-focus => {
        if (self.want-focus) {
            fs.focus();
        }
    }
    fs := FocusScope {
        width: 0;
        height: 0;
        key-pressed(event) => {
            if ((event.text == Key.Return || event.text == " ")) {
                root.clicked();
                return accept;
            }
            if (root.nav(event.text)) {
                root.nav-took-back = event.text == Key.Back;
                return accept;
            }
            return reject;
        }
        key-released(event) => {
            // Android sends Back's release separately; keep it here when
            // the press was handled.
            if (event.text == Key.Back && root.nav-took-back) {
                root.nav-took-back = false;
                return accept;
            }
            return reject;
        }
    }
    property <bool> nav-took-back;

    height: Theme.control-height;
    border-radius: 10px;
    border-width: fs.has-focus ? 2px : 0px;
    border-color: Theme.accent;
    background: touch.pressed || touch.has-hover || fs.has-focus ? Theme.card-hover : transparent;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            Icon {
                name: root.icon;
                tint: root.danger ? Theme.danger : Theme.text;
            }
        }
        Text {
            text: root.text;
            color: root.danger ? Theme.danger : Theme.text;
            font-size: Theme.body-size;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component PillButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked;
    // Keyboard / TV remote: focusable (Tab, or `want-focus`), Return or
    // Space presses it; arrows and Back go to `nav` (true: handled).
    in property <bool> want-focus;
    callback nav(string) -> bool;
    out property <bool> focused: fs.has-focus;
    init => {
        if (self.want-focus) {
            fs.focus();
        }
    }
    changed want-focus => {
        if (self.want-focus) {
            fs.focus();
        }
    }
    fs := FocusScope {
        width: 0;
        height: 0;
        key-pressed(event) => {
            if (root.enabled && (event.text == Key.Return || event.text == " ")) {
                root.clicked();
                return accept;
            }
            if (root.nav(event.text)) {
                root.nav-took-back = event.text == Key.Back;
                return accept;
            }
            return reject;
        }
        key-released(event) => {
            // Android sends Back's release separately; keep it here when
            // the press was handled.
            if (event.text == Key.Back && root.nav-took-back) {
                root.nav-took-back = false;
                return accept;
            }
            return reject;
        }
    }
    property <bool> nav-took-back;

    min-width: label.preferred-width + 32px;
    preferred-width: label.preferred-width + 32px;
    horizontal-stretch: 0;
    height: Theme.control-height;
    border-radius: self.height / 2;
    border-width: fs.has-focus ? 2px : (root.primary ? 0px : 1px);
    border-color: fs.has-focus ? (root.primary ? Theme.text : Theme.accent) : (root.danger ? Theme.danger : Theme.border);
    opacity: root.enabled ? 1.0 : 0.45;
    background: root.primary
        ? (touch.has-hover || touch.pressed ? Theme.accent-hover : Theme.accent)
        : (touch.has-hover || touch.pressed ? Theme.card-hover : Theme.card);
    animate background { duration: 120ms; }

    label := Text {
        text: root.text;
        color: root.primary ? Theme.on-accent : (root.danger ? Theme.danger : Theme.text);
        font-size: Theme.body-size;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Text link; wraps instead of overflowing narrow dialogs.
export component LinkButton inherits Rectangle {
    in property <string> text;
    callback clicked;
    min-height: Theme.compact ? 40px : 28px;
    preferred-height: label.preferred-height + 12px;

    label := Text {
        width: parent.width;
        text: root.text;
        color: touch.has-hover ? Theme.accent-hover : Theme.accent;
        font-size: 13px;
        font-weight: 600;
        wrap: word-wrap;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component Chip inherits Rectangle {
    in property <string> text;
    in property <color> tone: Theme.muted;
    height: 24px;
    min-width: label.preferred-width + 18px;
    preferred-width: label.preferred-width + 18px;
    horizontal-stretch: 0;
    border-radius: 12px;
    background: root.tone.transparentize(0.84);

    label := Text {
        text: root.text;
        color: root.tone;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Translucent backdrop + centered card for dialogs.
export component Dialog inherits Rectangle {
    in property <length> card-width: 420px;
    callback dismissed;
    background: #000000b0;

    TouchArea {
        clicked => {
            root.dismissed();
        }
    }

    Rectangle {
        width: Math.min(root.card-width, root.width - (Theme.compact ? 24px : 32px));
        height: content.preferred-height;
        border-radius: Theme.radius;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 30px;
        drop-shadow-color: #00000088;

        // Swallow clicks so they don't reach the backdrop.
        TouchArea { }

        content := VerticalLayout {
            padding: Theme.compact ? 20px : 24px;
            spacing: 14px;
            @children
        }
    }
}
